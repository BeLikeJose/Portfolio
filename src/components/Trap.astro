---
// Mousetrap as a collection piece: 3D trap seen from above, a paper card and a museum label.
---
<div class="obj trap-obj">
  <div class="obj-stage">
    <div class="trap3d" id="trap3d"></div>
    <div class="obj-card" id="trapCard" style="right:4%;bottom:14%"><b>No hagas clic.</b></div>
  </div>
  <p class="ficha"><span class="n">fig. 001</span><br /><b>Cursor común</b>, 2026.<br />Pino, acero y una mala decisión.<br />— Colección be like josé</p>
  <button class="obj-reset" id="trapReset" hidden>↺ armar de nuevo</button>
</div>

<script>
  import { createTrap } from '../scripts/trap3d.js';
  const card = document.getElementById('trapCard')!;
  const resetBtn = document.getElementById('trapReset')!;
  const swap = (html: string) => { card.classList.remove('swap'); void card.offsetWidth; card.classList.add('swap'); setTimeout(() => (card.innerHTML = html), 180); };
  await document.fonts.ready;
  const trap = createTrap(document.getElementById('trap3d')!, {
    delay: 300,
    onSnap() {
      setTimeout(() => (window as any).doFlash?.(), 60);
      setTimeout(() => swap('<b>Caíste.</b><i>así se engancha una buena idea.</i>'), 350);
      resetBtn.hidden = false;
    },
  });
  resetBtn.addEventListener('click', () => { trap.reset(); resetBtn.hidden = true; swap('<b>No hagas clic.</b>'); });
  (window as any).__trap = trap;
</script>
