---
// Mousetrap made of three real clips: idle loop → snap → snapped loop. Click to fire.
const M = '/media/trampa';
---
<div class="trap-float" id="trap" role="button" tabindex="0" aria-label="trampa de ratón: no hagas clic">
  <video class="tv on" id="tvIdle" src={`${M}/reposo.mp4`} poster={`${M}/poster-a.jpg`} autoplay muted loop playsinline preload="auto"></video>
  <video class="tv" id="tvSnap" src={`${M}/accion.mp4`} playsinline preload="auto"></video>
  <video class="tv" id="tvDone" src={`${M}/despues.mp4`} poster={`${M}/poster-b.jpg`} muted loop playsinline preload="auto"></video>
  <div class="obj-card" id="trapCard"><b>No hagas clic.</b></div>
  <button class="obj-reset trap-reset" id="trapReset" hidden>↺ armar de nuevo</button>
</div>

<style>
  .trap-float { cursor: pointer; animation: hover-float 5.5s ease-in-out infinite; }
  .trap-float:hover { animation-play-state: paused; }
  @keyframes hover-float { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-10px) rotate(-2.5deg); } }
  .tv { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity .12s; pointer-events: none;
    --fx: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent); --fy: linear-gradient(to bottom, transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-image: var(--fx), var(--fy); -webkit-mask-composite: source-in; mask-image: var(--fx), var(--fy); mask-composite: intersect; }
  .tv.on { opacity: 1; }
  .trap-float.jolt .tv { animation: tjolt .35s; }
  @keyframes tjolt { 20% { transform: translate(-3px, 2px); } 45% { transform: translate(2px, -1px); } 70% { transform: translate(-1px, 1px); } }
</style>

<script>
  const root = document.getElementById('trap')!;
  const idle = document.getElementById('tvIdle') as HTMLVideoElement;
  const snap = document.getElementById('tvSnap') as HTMLVideoElement;
  const done = document.getElementById('tvDone') as HTMLVideoElement;
  const card = document.getElementById('trapCard')!;
  const resetBtn = document.getElementById('trapReset')!;
  const SLAM_AT = 0.2; // seconds into accion.mp4 when the bar hits
  let state: 'set' | 'firing' | 'shut' = 'set';

  const show = (v: HTMLVideoElement) => [idle, snap, done].forEach((x) => x.classList.toggle('on', x === v));
  const swap = (html: string) => { card.classList.remove('swap'); void card.offsetWidth; card.classList.add('swap'); setTimeout(() => (card.innerHTML = html), 180); };

  function fire() {
    if (state !== 'set') return;
    state = 'firing';
    snap.currentTime = 0; snap.muted = false; snap.volume = 0.6;
    snap.play().then(() => { show(snap); idle.pause(); }).catch(() => { show(done); done.play(); state = 'shut'; });
    setTimeout(() => { root.classList.add('jolt'); (window as any).doFlash?.(); }, SLAM_AT * 1000);
    setTimeout(() => root.classList.remove('jolt'), SLAM_AT * 1000 + 400);
    setTimeout(() => swap('<b>Caíste.</b><i>así se engancha una buena idea.</i>'), 450);
    resetBtn.hidden = false;
  }
  snap.addEventListener('ended', () => { done.currentTime = 0; done.play(); show(done); state = 'shut'; });

  root.addEventListener('click', (e) => { if ((e.target as Element).closest('#trapReset')) return; fire(); });
  root.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fire(); } });
  resetBtn.addEventListener('click', () => {
    idle.currentTime = 0; idle.play(); show(idle); done.pause();
    state = 'set'; resetBtn.hidden = true; swap('<b>No hagas clic.</b>');
  });
</script>
