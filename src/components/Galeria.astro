---
// Galería de un caso: miniaturas con su proporción original; al tocar una, se abre en grande
// (flechas, teclado y deslizar en el teléfono). Los videos usan el reproductor nativo del navegador.
import type { Pieza } from '../lib/obra';
interface Props { piezas: Pieza[] }
const piezas = Astro.props.piezas.filter((p) => p.imagen || p.video);
const data = JSON.stringify(piezas.map((p) => ({ img: p.imagen || p.poster || '', video: p.video || '', nota: p.nota || '' })));
---
{piezas.length > 0 && (
  <section class="gal" id="galeria">
    <div class="gal-head"><span class="mono">galería</span><span class="mono">{String(piezas.length).padStart(2, '0')} piezas</span></div>
    <div class="gal-grid">
      {piezas.map((p, i) => (
        <figure class="gal-item">
          <button type="button" class="gal-thumb" data-i={i} aria-label={`abrir pieza ${i + 1}${p.nota ? ': ' + p.nota : ''}`}>
            {p.video && !p.poster && !p.imagen
              ? <video src={`${p.video}#t=0.1`} muted playsinline preload="metadata"></video>
              : <img src={(p.imagen || p.poster)!} alt={p.nota ?? ''} decoding="async" />}
            {p.video && <span class="gal-play" aria-hidden="true">▶</span>}
          </button>
          {p.nota && <figcaption class="mono">{p.nota}</figcaption>}
        </figure>
      ))}
    </div>
    <dialog class="lb" id="lb" data-items={data} aria-label="galería">
      <div class="lb-top"><span class="mono" id="lbCount"></span><button type="button" class="lb-x mono" data-lb="close">cerrar ✕</button></div>
      <div class="lb-stage" id="lbStage"></div>
      <p class="lb-nota mono" id="lbNota"></p>
      {piezas.length > 1 && <button type="button" class="lb-nav lb-prev" data-lb="prev" aria-label="anterior">←</button>}
      {piezas.length > 1 && <button type="button" class="lb-nav lb-next" data-lb="next" aria-label="siguiente">→</button>}
    </dialog>
  </section>
)}

<style is:global>
  .gal { margin-top: 90px; }
  .gal-head { display: flex; justify-content: space-between; border-top: 1px solid var(--ink); padding-top: 12px; margin-bottom: 22px; font-size: 10px; text-transform: uppercase; color: #777; }
  .gal-grid { columns: 3; column-gap: 18px; }
  .gal-item { break-inside: avoid; margin: 0 0 18px; }
  .gal-thumb { display: block; position: relative; width: 100%; padding: 0; border: 0; background: var(--paper); cursor: zoom-in; overflow: hidden; }
  .gal-thumb img, .gal-thumb video { display: block; width: 100%; height: auto; transition: transform .6s cubic-bezier(.16, 1, .3, 1), opacity .3s; }
  .gal-thumb:hover img, .gal-thumb:hover video { transform: scale(1.03); opacity: .92; }
  .gal-play { position: absolute; inset: 0; margin: auto; width: 54px; height: 54px; border-radius: 50%; background: rgba(250, 250, 250, .92); color: var(--ink); display: grid; place-items: center; font-size: 16px; padding-left: 3px; }
  .gal-item figcaption { font-size: 10px; text-transform: uppercase; color: #666; margin-top: 7px; line-height: 1.4; }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #0a0a0a; color: #fafafa; }
  .lb[open] { display: grid; grid-template-rows: auto 1fr auto; animation: lbIn .25s ease; }
  @keyframes lbIn { from { opacity: 0; } }
  .lb::backdrop { background: rgba(10, 10, 10, .6); }
  .lb-top { display: flex; justify-content: space-between; align-items: center; padding: 16px 22px; font-size: 11px; }
  .lb-x { background: none; border: 0; color: #fafafa; font-size: 11px; text-transform: uppercase; cursor: pointer; padding: 10px; margin: -10px; }
  .lb-stage { display: grid; place-items: center; min-height: 0; padding: 0 70px; touch-action: pan-y; }
  .lb-stage img, .lb-stage video { max-width: 100%; max-height: calc(100dvh - 130px); width: auto; height: auto; object-fit: contain; display: block; }
  .lb-nota { text-align: center; font-size: 11px; text-transform: uppercase; color: #bbb; padding: 14px 22px 20px; min-height: 1em; }
  .lb-nav { position: absolute; top: 50%; translate: 0 -50%; width: 50px; height: 50px; border-radius: 50%; border: 1px solid rgba(250, 250, 250, .4); background: rgba(10, 10, 10, .4); color: #fafafa; font-size: 18px; cursor: pointer; }
  .lb-prev { left: 12px; } .lb-next { right: 12px; }
  .lb-nav:hover { background: #fafafa; color: var(--ink); }
  html.lb-open { overflow: hidden; }
  @media (max-width: 900px) { .gal-grid { columns: 2; column-gap: 12px; } .gal-item { margin-bottom: 12px; } }
  @media (max-width: 560px) {
    .gal { margin-top: 60px; }
    .lb-stage { padding: 0 10px; }
    .lb-nav { top: auto; bottom: 10px; translate: none; width: 44px; height: 44px; }
  }
</style>

<script>
  const lb = document.getElementById('lb') as HTMLDialogElement | null;
  if (lb) {
    const items: { img: string; video: string; nota: string }[] = JSON.parse(lb.dataset.items || '[]');
    const stage = document.getElementById('lbStage')!, count = document.getElementById('lbCount')!, nota = document.getElementById('lbNota')!;
    let cur = 0;
    const show = (i: number) => {
      cur = (i + items.length) % items.length;
      const it = items[cur];
      stage.querySelector('video')?.pause();
      stage.innerHTML = '';
      if (it.video) {
        const v = document.createElement('video');
        v.src = it.video; v.controls = true; v.playsInline = true; v.autoplay = true; if (it.img) v.poster = it.img;
        stage.append(v);
      } else {
        const im = document.createElement('img'); im.src = it.img; im.alt = it.nota; stage.append(im);
      }
      count.textContent = `${String(cur + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
      nota.textContent = it.nota;
    };
    const close = () => lb.close();
    lb.addEventListener('close', () => { stage.querySelector('video')?.pause(); stage.innerHTML = ''; document.documentElement.classList.remove('lb-open'); });
    document.querySelectorAll<HTMLButtonElement>('.gal-thumb').forEach((b) => b.addEventListener('click', () => {
      show(Number(b.dataset.i)); lb.showModal(); document.documentElement.classList.add('lb-open');
    }));
    lb.addEventListener('click', (e) => {
      const t = e.target as HTMLElement, a = t.closest('[data-lb]') as HTMLElement | null;
      if (a?.dataset.lb === 'close') close();
      else if (a?.dataset.lb === 'prev') show(cur - 1);
      else if (a?.dataset.lb === 'next') show(cur + 1);
      else if (t === lb || t === stage) close(); // tocar fuera de la pieza cierra
    });
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
    let x0: number | null = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null || items.length < 2) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
    });
  }
</script>
