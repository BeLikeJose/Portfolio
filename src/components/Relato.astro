---
// El relato de un caso, escrito en el panel como texto simple:
//   línea en blanco = párrafo nuevo · "## " = subtítulo · "- " = lista · "> " = cita · **texto** = negrita
interface Props { texto: string }
const { texto } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inline = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
const html = texto.trim().split(/\n\s*\n/).map((block) => {
  let lines = block.split('\n').map((l) => l.trim()).filter(Boolean);
  let out = '';
  if (lines[0]?.startsWith('## ')) { out += `<h3>${inline(lines[0].slice(3))}</h3>`; lines = lines.slice(1); }
  if (!lines.length) return out;
  if (lines.every((l) => l.startsWith('- '))) return out + `<ul>${lines.map((l) => `<li>${inline(l.slice(2))}</li>`).join('')}</ul>`;
  if (lines.every((l) => l.startsWith('> '))) return out + `<blockquote>${lines.map((l) => inline(l.slice(2))).join(' ')}</blockquote>`;
  return out + `<p>${lines.map(inline).join('<br />')}</p>`;
}).join('');
---
{texto.trim() && <div class="relato" set:html={html} />}

<style is:global>
  .relato { max-width: 64ch; }
  .relato h3 { font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #777; margin: 44px 0 14px; padding-top: 14px; border-top: 1px solid var(--line); }
  .relato h3:first-child { margin-top: 0; }
  .relato p, .relato li { font-size: 17px; line-height: 1.6; }
  .relato p + p, .relato p + ul, .relato ul + p, .relato blockquote + p { margin-top: 14px; }
  .relato ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
  .relato li { padding-left: 22px; position: relative; }
  .relato li::before { content: '—'; position: absolute; left: 0; color: #999; }
  .relato b { font-weight: 600; }
  .relato blockquote { font-family: 'Instrument Serif', serif; font-size: clamp(24px, 2.2vw, 32px); line-height: 1.18; margin: 22px 0; padding-left: 20px; border-left: 2px solid var(--ink); }
  @media (max-width: 560px) { .relato p, .relato li { font-size: 16px; } }
</style>
