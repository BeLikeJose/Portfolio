---
// Brújula real (foto) + aguja recortada que gira con código: sigue el cursor y se queda en el eje que eliges.
// Imágenes en /media/brujula: brujula.jpg (centrada en su pivote, fondo blanco) y aguja.webp (centrada en su tapa).
const M = '/media/brujula';
const axes = [
  { n: '01', name: 'Dirección creativa', a: 0 },
  { n: '02', name: 'Operaciones y oferta de valor', a: 90 },
  { n: '03', name: 'Proyección empresarial', a: 180 },
  { n: '04', name: 'Creación de contenidos', a: 270 },
];
const LR = 22.5; // distancia de los números al centro, en % del ancho
const pos = (a: number) => { const t = a * Math.PI / 180; return `left:${50 + LR * Math.sin(t)}%;top:${50 - LR * Math.cos(t)}%`; };
---
<div class="compass-obj" id="compass">
  <div class="cstage" id="cstage" aria-label="brújula de los cuatro ejes">
    <img class="cbase" src={`${M}/brujula.jpg`} alt="" draggable="false" />
    {axes.map((ax, i) => <button type="button" class="cpt" data-i={i} style={pos(ax.a)} aria-label={`eje ${ax.n}: ${ax.name}`}>{ax.n}</button>)}
    <img class="cneedle" id="needle" src={`${M}/aguja.webp`} alt="" draggable="false" />
    <span class="cglass" aria-hidden="true"></span>
  </div>
  <div class="compass-read mono" id="compassRead">mueve el cursor — elige un rumbo</div>
  <p class="ficha"><span class="n">fig. 004</span><br /><b>Brújula</b>, 2026.<br />Latón, vidrio y un norte que se elige.<br />— Colección be like josé</p>
</div>

<style>
  .compass-obj { display: flex; flex-direction: column; align-items: flex-start; }
  .cstage { position: relative; width: min(320px, 100%); aspect-ratio: 1; user-select: none; touch-action: none; cursor: crosshair; }
  .cbase { position: absolute; inset: 0; width: 100%; height: 100%; mix-blend-mode: multiply; pointer-events: none; }
  /* aguja: el lienzo es cuadrado y está centrado en la tapa, así gira sobre el pivote */
  .cneedle { position: absolute; left: 31%; top: 31%; width: 38%; height: 38%; pointer-events: none;
    filter: drop-shadow(1px 5px 3px rgba(40, 25, 5, .35)); transition: transform 1.1s cubic-bezier(.2, 1.9, .4, 1); }
  .compass-obj.follow .cneedle { transition: transform .35s cubic-bezier(.2, 1.5, .4, 1); }
  .cglass { position: absolute; left: 12%; top: 12%; width: 76%; height: 76%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle at 30% 24%, rgba(255, 255, 255, .45), rgba(255, 255, 255, 0) 38%); }
  .cpt { position: absolute; translate: -50% -50%; background: none; border: 0; padding: 4px 6px; cursor: pointer;
    font: 400 clamp(17px, 1.6vw, 22px) 'Instrument Serif', serif; color: #3a2f22; line-height: 1; transition: color .25s, transform .25s; }
  .cpt:hover { transform: scale(1.15); }
  .cpt.on { color: #8e1c17; text-decoration: underline; text-underline-offset: 3px; }
  .compass-read { margin-top: 12px; padding: 8px 10px; border: 1px solid var(--ink); min-width: 260px; }

  @media (max-width: 900px) {
    .compass-obj { align-items: center; }
    .cstage { width: min(300px, 82vw); touch-action: manipulation; }
    .compass-read { min-width: 0; width: 100%; text-align: center; }
  }
</style>

<script>
  const root = document.getElementById('compass')!;
  const stage = document.getElementById('cstage')!;
  const needle = document.getElementById('needle')!;
  const read = document.getElementById('compassRead')!;
  const pts = [...root.querySelectorAll<HTMLButtonElement>('.cpt')];
  const NAMES = ['Dirección creativa', 'Operaciones y oferta de valor', 'Proyección empresarial', 'Creación de contenidos'];
  const arts = ['eje-01', 'eje-02', 'eje-03', 'eje-04'].map((id) => document.getElementById(id));
  let angle = 0, sel = -1;
  if (matchMedia('(hover: none)').matches) read.textContent = 'toca un rumbo';
  const turn = (a: number) => { let d = a - (angle % 360); if (d > 180) d -= 360; if (d < -180) d += 360; angle += d; needle.style.transform = `rotate(${angle}deg)`; };
  const bearing = (e: PointerEvent | MouseEvent) => { const b = stage.getBoundingClientRect(); return Math.atan2(e.clientY - (b.top + b.height / 2), e.clientX - (b.left + b.width / 2)) * 180 / Math.PI + 90; };
  const choose = (i: number) => {
    sel = i; root.classList.remove('follow'); turn(i * 90);
    pts.forEach((p, k) => p.classList.toggle('on', k === i));
    arts.forEach((a, k) => a?.classList.toggle('lit', k === i));
    read.textContent = `rumbo ${String(i + 1).padStart(2, '0')} — ${NAMES[i]}`;
  };
  stage.addEventListener('pointermove', (e) => { if (e.pointerType === 'touch') return; root.classList.add('follow'); turn(bearing(e)); });
  stage.addEventListener('pointerleave', () => { if (sel >= 0) choose(sel); else { root.classList.remove('follow'); turn(0); } });
  stage.addEventListener('click', (e) => {
    const p = (e.target as Element).closest('.cpt') as HTMLButtonElement | null;
    if (p) return choose(Number(p.dataset.i));
    choose(Math.round(((bearing(e) + 360) % 360) / 90) % 4);
  });
  arts.forEach((a, i) => a?.addEventListener('mouseenter', () => choose(i)));
  // en reposo, un leve temblor, como una aguja de verdad
  setInterval(() => { if (!root.classList.contains('follow')) needle.style.transform = `rotate(${angle + (Math.random() - .5) * 4}deg)`; }, 1600);
</script>
