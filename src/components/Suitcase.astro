---
// La maleta: un clip real (se abren los cierres y la tapa) y, al abrirse, sale el equipo real.
// Video en /media/maleta (fondo igualado a la web); fotos recortadas en /media/maleta/equipo.
// Para cambiar el equipo: edita ITEMS (x/y = posición en % del escenario, w = ancho en px en escritorio).
const M = '/media/maleta';
const ITEMS = [
  { id: 'tripode', name: 'Trípode K&F Concept', use: 'Entrevistas y planos quietos.', x: 2, y: 2, w: 104, r: -4 },
  { id: 'a7iv', name: 'Sony a7 IV', use: 'Full frame. El ojo principal.', x: 13, y: 4, w: 168, r: -3 },
  { id: '35mm', name: 'Viltrox 35 mm f1.2 LAB', use: 'La distancia de una conversación.', x: 4, y: 40, w: 66, r: 3 },
  { id: 'zoom', name: 'Sony 28-70 mm f3.5-5.6', use: 'Del plano abierto al detalle.', x: 14, y: 40, w: 104, r: -6 },
  { id: 'gimbal', name: 'DJI RS4 mini', use: 'Movimiento sin temblor.', x: 3, y: 66, w: 96, r: 2 },
  { id: 'pocket', name: 'DJI Osmo Pocket 3', use: 'Para lo que pasa sin aviso.', x: 17, y: 68, w: 40, r: -4 },
  { id: 'mic', name: 'Hollyland Lark M2 Duo', use: 'La voz pesa tanto como la imagen.', x: 75, y: 4, w: 118, r: 4 },
  { id: 'inear', name: 'KZ ZSN Pro', use: 'Escucho lo que de verdad se grabó.', x: 88, y: 3, w: 92, r: -3 },
  { id: 'nd', name: 'K&F ND + CPL Nano-X', use: 'Para filmar a pleno sol.', x: 75, y: 38, w: 92, r: -5 },
  { id: 'diffusion', name: 'K&F Black Diffusion 1/4', use: 'Suaviza la luz, look de cine.', x: 87, y: 40, w: 92, r: 6 },
  { id: 'flash', name: '2 × Godox iT30 Pro', use: 'La foto del evento, bien iluminada.', x: 72, y: 70, w: 132, r: 3 },
  { id: 'luz', name: 'Barra RGB Neewer', use: 'Color donde no hay luz.', x: 91, y: 64, w: 46, r: 8 },
];
const OPEN_AT = 3.0; // segundo del clip en que la tapa ya dejó ver el interior
---
<div class="suit-obj" id="suitcase" data-open={OPEN_AT}>
  <div class="suit-stage">
    <div class="suit-box" id="suitBox" role="button" tabindex="0" aria-label="abrir la maleta">
      <img class="sv on" id="svClosed" src={`${M}/cerrada.jpg`} alt="" />
      <video class="sv" id="svClip" src={`${M}/maleta.mp4`} poster={`${M}/cerrada.jpg`} playsinline preload="auto"></video>
    </div>
    <div class="gear" id="gear">
      {ITEMS.map((it, i) => (
        <figure class="item" data-i={i} style={`--x:${it.x}%;--y:${it.y}%;--w:${it.w}px;--r:${it.r}deg;--d:${i * 55}ms`} tabindex="0">
          <img src={`${M}/equipo/${it.id}.webp`} alt={it.name} loading="lazy" />
          <figcaption class="itag"><b>{it.name}</b><span>{it.use}</span></figcaption>
        </figure>
      ))}
    </div>
    <div class="obj-card suit-card" id="suitCard"><b>Ábreme.</b><i>es lo que llevo a cada rodaje.</i></div>
  </div>
  <p class="ficha"><span class="n">fig. 005</span><br /><b>Maleta</b>, 2026.<br />Polímero, espuma y todo lo que cabe para crear.<br />— Colección be like josé</p>
  <button class="obj-reset" id="suitReset" hidden>↺ cerrar la maleta</button>
</div>

<style>
  .suit-stage { position: relative; height: 640px; max-width: 1240px; margin: 0 auto; }
  .suit-box { position: absolute; left: 50%; bottom: 0; width: min(600px, 48%); aspect-ratio: 960 / 726; translate: -50% 0; cursor: pointer; z-index: 1; mix-blend-mode: multiply; } /* el fondo blanco del video desaparece contra la página */
  .suit-obj.open .suit-box { cursor: default; }
  .sv { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity .12s; pointer-events: none;
    --fx: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); --fy: linear-gradient(to bottom, transparent, #000 6%, #000 90%, transparent);
    -webkit-mask-image: var(--fx), var(--fy); -webkit-mask-composite: source-in; mask-image: var(--fx), var(--fy); mask-composite: intersect; }
  .sv.on { opacity: 1; }

  .suit-obj:not(.open) .suit-box:hover { animation: nudge .5s; }
  @keyframes nudge { 30% { transform: rotate(-.6deg); } 60% { transform: rotate(.5deg); } }

  .gear { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .item { position: absolute; left: var(--x); top: var(--y); width: var(--w); margin: 0; opacity: 0; transform: var(--from, translate(0, 40px)) scale(.2); pointer-events: none; outline: 0; }
  .suit-obj.open .item { opacity: 1; transform: rotate(var(--r)); pointer-events: auto; transition: transform .9s cubic-bezier(.2, 1.25, .4, 1) var(--d), opacity .25s var(--d); }
  .item img { display: block; width: 100%; height: auto; filter: drop-shadow(0 14px 14px rgba(0, 0, 0, .28)); transition: transform .3s; }
  .item:hover img, .item:focus img { transform: translateY(-6px) scale(1.05); }
  .itag { position: absolute; left: 50%; top: calc(100% + 6px); translate: -50% 0; width: max-content; max-width: 190px; background: #f7f5f0; padding: 6px 9px; box-shadow: 0 10px 18px -10px rgba(0, 0, 0, .5); rotate: calc(var(--r) * -1); z-index: 3; }
  .itag b { display: block; font: 500 10px/1.2 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .03em; }
  .itag span { display: none; font-family: 'Instrument Serif', serif; font-size: 16px; line-height: 1.05; margin-top: 3px; }
  .item:hover .itag span, .item:focus .itag span { display: block; }
  .item:hover, .item:focus { z-index: 5; }
  .suit-card { left: 50%; top: 6%; translate: -50% 0; z-index: 4; }

  @media (max-width: 900px) {
    .suit-stage { height: auto; display: flex; flex-direction: column; gap: 18px; }
    .suit-box { position: relative; left: auto; translate: none; width: 100%; }
    .gear { position: relative; inset: auto; display: none; grid-template-columns: repeat(3, 1fr); gap: 22px 12px; }
    .suit-obj.open .gear { display: grid; }
    .item { position: relative; left: auto; top: auto; width: auto; transform: translateY(20px) scale(.9); display: flex; flex-direction: column; align-items: center; }
    .suit-obj.open .item { transform: none; }
    .item img { width: auto; max-width: 100%; height: 86px; object-fit: contain; }
    .itag { position: static; translate: none; rotate: none; max-width: none; width: 100%; margin-top: 8px; padding: 6px 7px; }
    .itag b { font-size: 9px; }
    .itag span { display: block; font-size: 14px; }
    .suit-card { position: relative; left: auto; top: auto; translate: none; align-self: flex-end; order: 3; }
  }
</style>

<script>
  const root = document.getElementById('suitcase')!;
  const OPEN_AT = Number(root.dataset.open);
  const box = document.getElementById('suitBox')!;
  const closed = document.getElementById('svClosed')!;
  const clip = document.getElementById('svClip') as HTMLVideoElement;
  const items = [...root.querySelectorAll<HTMLElement>('.item')];
  const card = document.getElementById('suitCard')!;
  const reset = document.getElementById('suitReset')!;
  const setCard = (h: string) => { card.classList.remove('swap'); void card.offsetWidth; card.classList.add('swap'); setTimeout(() => (card.innerHTML = h), 180); };
  const desktop = () => matchMedia('(min-width: 901px)').matches;
  let state: 'closed' | 'opening' | 'open' = 'closed';

  // Each item starts at the mouth of the case and flies to its place.
  const aim = () => {
    if (!desktop()) { items.forEach((it) => it.style.removeProperty('--from')); return; }
    const b = box.getBoundingClientRect(), cx = b.left + b.width / 2, cy = b.top + b.height * .55;
    items.forEach((it) => { it.style.transition = 'none'; it.style.transform = 'none'; });
    const rects = items.map((it) => it.getBoundingClientRect());
    items.forEach((it, i) => { const r = rects[i]; it.style.setProperty('--from', `translate(${cx - (r.left + r.width / 2)}px, ${cy - (r.top + r.height / 2)}px)`); it.style.transform = ''; });
    void root.offsetWidth; items.forEach((it) => (it.style.transition = ''));
  };
  const popOut = () => {
    if (state === 'open') return;
    state = 'open'; root.classList.add('open'); reset.hidden = false;
    setCard(matchMedia('(hover: none)').matches ? '<b>Con esto produzco.</b><i>mi equipo, pieza por pieza.</i>' : '<b>Con esto produzco.</b><i>pasa el cursor por cada cosa.</i>');
  };

  function open() {
    if (state !== 'closed') return;
    state = 'opening'; aim();
    clip.currentTime = 0; clip.muted = false; clip.volume = 0.6;
    const go = () => { clip.classList.add('on'); closed.classList.remove('on'); };
    clip.play().then(go).catch(() => { clip.muted = true; clip.play().then(go).catch(() => { clip.currentTime = clip.duration || 5; go(); popOut(); }); });
    setCard('<b>Clic, clic…</b><i>un momento.</i>');
  }
  clip.addEventListener('timeupdate', () => { if (state === 'opening' && clip.currentTime >= OPEN_AT) popOut(); });
  clip.addEventListener('ended', () => { if (state === 'opening') popOut(); });

  box.addEventListener('click', open);
  box.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
  reset.addEventListener('click', () => {
    clip.pause(); clip.currentTime = 0; closed.classList.add('on'); clip.classList.remove('on');
    root.classList.remove('open'); state = 'closed'; reset.hidden = true;
    setCard('<b>Ábreme.</b><i>es lo que llevo a cada rodaje.</i>');
  });
  addEventListener('resize', () => { if (state !== 'open') aim(); });
</script>
