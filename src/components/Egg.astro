---
// Egg: tap three times to break the shell. A note comes out: "Aquí puede estar tu marca, rompiendo la cáscara."
const EGG = 'M150 40 C 214 40 244 150 244 196 C 244 256 202 292 150 292 C 98 292 56 256 56 196 C 56 150 86 40 150 40 Z';
const ZIG = 'M40 172 L68 160 L90 182 L116 158 L140 186 L164 160 L188 184 L212 158 L236 180 L262 166';
---
<div class="egg-obj" id="egg">
  <div class="egg-stage">
    <div class="note" id="eggNote"><span>Aquí puede estar</span><b>tu marca,</b><i>rompiendo la cáscara.</i><a href="#contacto">hablemos →</a></div>
    <svg class="egg" viewBox="0 0 300 330" aria-label="huevo interactivo">
      <defs>
        <radialGradient id="shell" cx=".38" cy=".32" r=".8"><stop offset="0" stop-color="#fffdf8" /><stop offset=".55" stop-color="#f1ebe0" /><stop offset="1" stop-color="#cfc6b6" /></radialGradient>
        <radialGradient id="inside" cx=".5" cy=".3" r=".8"><stop offset="0" stop-color="#fbf7ee" /><stop offset="1" stop-color="#e7dfcf" /></radialGradient>
        <clipPath id="topHalf"><path d={`${ZIG} L262 0 L40 0 Z`} /></clipPath>
        <clipPath id="botHalf"><path d={`${ZIG} L262 330 L40 330 Z`} /></clipPath>
        <filter id="speck"><feTurbulence type="fractalNoise" baseFrequency="2.2" numOctaves="1" seed="4" /><feColorMatrix values="0 0 0 0 .45  0 0 0 0 .38  0 0 0 0 .3  0 0 0 18 -15" /><feComposite in2="SourceGraphic" operator="in" /></filter>
      </defs>
      <ellipse class="eshadow" cx="150" cy="298" rx="78" ry="10" fill="rgba(0,0,0,.28)" filter="blur(5px)" />
      <g class="wob">
        <g class="bot" clip-path="url(#botHalf)"><path d={EGG} fill="url(#shell)" /><path d={EGG} filter="url(#speck)" /></g>
        <path class="rim" d={ZIG} fill="none" stroke="#e7dfcf" stroke-width="3" />
        <g class="top" clip-path="url(#topHalf)"><path d={EGG} fill="url(#shell)" /><path d={EGG} filter="url(#speck)" /></g>
        <path class="crack c1" d="M140 186 L164 160 L188 184" pathLength="1" />
        <path class="crack c2" d="M68 160 L90 182 L116 158 L140 186 M188 184 L212 158 L236 180 M164 160 L170 140 L162 126" pathLength="1" />
      </g>
    </svg>
    <div class="obj-card egg-card" id="eggCard"><b>Rómpelo.</b><i>tres golpes bastan.</i></div>
  </div>
  <p class="ficha"><span class="n">fig. 006</span><br /><b>Huevo</b>, 2026.<br />Cáscara, calcio y una marca por nacer.<br />— Colección be like josé</p>
  <button class="obj-reset" id="eggReset" hidden>↺ otro huevo</button>
</div>

<style>
  .egg-stage { position: relative; height: 460px; display: grid; place-items: center; }
  .egg { width: 240px; overflow: visible; cursor: pointer; position: relative; z-index: 2; }
  .crack { fill: none; stroke: #6d6253; stroke-width: 2.2; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .25s ease-out; }
  .egg-obj.h1 .c1, .egg-obj.h2 .c2, .egg-obj.h2 .c1 { stroke-dashoffset: 0; }
  .wob { transform-box: fill-box; transform-origin: 50% 100%; }
  .egg-obj.hit .wob { animation: eggwob .45s; }
  @keyframes eggwob { 20% { transform: rotate(-6deg); } 45% { transform: rotate(5deg); } 70% { transform: rotate(-2deg); } }
  .top { transform-box: fill-box; transform-origin: 20% 100%; transition: transform .9s cubic-bezier(.3, 1.3, .5, 1), opacity .4s .7s; }
  .egg-obj.broken .top { transform: translate(-90px, -40px) rotate(-62deg); }
  .egg-obj.broken .crack { opacity: 0; }
  .rim { opacity: 0; }
  .egg-obj.broken .rim { opacity: 1; }
  .note { position: absolute; z-index: 1; left: 50%; top: 52%; width: 230px; translate: -50% 0; background: #f7f5f0; padding: 16px 18px 14px; text-align: center; box-shadow: 0 18px 30px -16px rgba(0, 0, 0, .5); transform: translateY(40px) scale(.4) rotate(-6deg); opacity: 0; transition: transform .9s cubic-bezier(.2, 1.5, .4, 1) .35s, opacity .3s .35s, z-index 0s .6s; }
  .egg-obj.broken .note { transform: translateY(-190px) scale(1) rotate(-3deg); opacity: 1; z-index: 3; }
  .note span { display: block; font-family: 'IBM Plex Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: #666; }
  .note b { display: block; font-weight: 700; font-size: 30px; line-height: 1; text-transform: uppercase; letter-spacing: -.02em; margin-top: 6px; }
  .note i { display: block; font-family: 'Instrument Serif', serif; font-size: 24px; line-height: 1; margin-top: 4px; }
  .note a { display: inline-block; margin-top: 12px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px; }
  .egg-card { right: 4%; bottom: 60px; }
</style>

<script>
  const root = document.getElementById('egg')!;
  const card = document.getElementById('eggCard')!;
  const reset = document.getElementById('eggReset')!;
  const setCard = (h: string) => { card.classList.remove('swap'); void card.offsetWidth; card.classList.add('swap'); setTimeout(() => (card.innerHTML = h), 180); };
  const crack = (v: number) => {
    try {
      const A = ((window as any).__ac ||= new AudioContext()), t = A.currentTime, n = A.sampleRate * .06, buf = A.createBuffer(1, n, A.sampleRate), d = buf.getChannelData(0);
      for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / n, 4);
      const s = A.createBufferSource(), f = A.createBiquadFilter(), g = A.createGain(); s.buffer = buf; f.type = 'highpass'; f.frequency.value = 1800; g.gain.value = v;
      s.connect(f).connect(g).connect(A.destination); s.start(t);
    } catch (e) {}
  };
  let hits = 0;
  root.querySelector('.egg')!.addEventListener('click', () => {
    if (hits >= 3) return;
    hits++; crack(.25 + hits * .15);
    root.classList.remove('hit'); void root.offsetWidth; root.classList.add('hit');
    if (hits === 1) { root.classList.add('h1'); setCard('<b>Crac.</b><i>otra vez.</i>'); }
    if (hits === 2) { root.classList.add('h2'); setCard('<b>Casi.</b><i>una más.</i>'); }
    if (hits === 3) { root.classList.add('broken'); setCard('<b>Rompiste la cáscara.</b><i>ahora sigue tu marca.</i>'); reset.hidden = false; }
  });
  reset.addEventListener('click', () => { hits = 0; root.classList.remove('h1', 'h2', 'broken', 'hit'); reset.hidden = true; setCard('<b>Rómpelo.</b><i>tres golpes bastan.</i>'); });
</script>
