---
// The toaster that burns = burnout. Turn the knob, push the lever, see what comes out.
// Lives next to the "Operaciones y oferta de valor" axis.
const levels = ['con dirección', 'a ojo', 'todo el día', 'sin parar'];
const angles = [-110, -38, 38, 110];
const kx = 180, ky = 222, kr = 21;
const lab = (a: number) => { const r = (a - 90) * Math.PI / 180; return { x: kx + Math.cos(r) * 42, y: ky + Math.sin(r) * 34 + 3 }; };
const slice = 'M0 30 C0 8 14 0 22 5 C30 -4 50 -4 58 5 C66 0 80 8 80 30 L78 104 L2 104 Z';
---
<div class="obj toaster-obj" id="toaster">
  <div class="obj-stage">
    <svg class="toaster" viewBox="0 0 360 330" aria-label="tostadora interactiva">
      <defs>
        <linearGradient id="chrome" x1="0" x2="1">
          <stop offset="0" stop-color="#8e8e8a" /><stop offset=".08" stop-color="#e9e9e6" /><stop offset=".22" stop-color="#b4b4af" />
          <stop offset=".42" stop-color="#fbfbfa" /><stop offset=".58" stop-color="#c9c9c4" /><stop offset=".8" stop-color="#f2f2ef" />
          <stop offset=".93" stop-color="#9d9d98" /><stop offset="1" stop-color="#6f6f6b" />
        </linearGradient>
        <linearGradient id="chromeV" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity=".55" /><stop offset=".25" stop-color="#fff" stop-opacity="0" />
          <stop offset=".75" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".28" />
        </linearGradient>
        <radialGradient id="knobG" cx=".4" cy=".35" r=".7"><stop offset="0" stop-color="#fff" /><stop offset=".55" stop-color="#bdbdb8" /><stop offset="1" stop-color="#6c6c68" /></radialGradient>
        <linearGradient id="glowG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff9a3c" stop-opacity=".95" /><stop offset="1" stop-color="#ff5a1f" stop-opacity="0" /></linearGradient>
        <filter id="tblur"><feGaussianBlur stdDeviation="7" /></filter>
        <filter id="sblur"><feGaussianBlur stdDeviation="4" /></filter>
        <clipPath id="aboveBody"><rect x="0" y="-200" width="360" height="292" /></clipPath>
      </defs>

      <ellipse cx="185" cy="304" rx="150" ry="13" fill="rgba(0,0,0,.32)" filter="url(#tblur)" />

      <!-- smoke (only when burnt) -->
      <g class="smoke">{[0, 1, 2, 3, 4].map((i) => <circle cx={140 + i * 20} cy="40" r={10 + (i % 3) * 5} fill="#8a8a86" filter="url(#sblur)" style={`animation-delay:${i * .35}s`} />)}</g>

      <!-- bread, behind the body; only the part above the slot is visible -->
      <g clip-path="url(#aboveBody)">
        <g class="bread" id="bread">
          <g transform="translate(92 52)"><path class="crumb" d={slice} fill="#efdcb4" stroke="#c99a5e" stroke-width="6" stroke-linejoin="round" /></g>
          <g transform="translate(188 46)"><path class="crumb" d={slice} fill="#efdcb4" stroke="#c99a5e" stroke-width="6" stroke-linejoin="round" />
            <text class="burnword" x="40" y="46" text-anchor="middle">burnout.</text></g>
        </g>
      </g>

      <!-- body -->
      <rect x="50" y="86" width="262" height="200" rx="46" fill="url(#chrome)" />
      <rect x="50" y="86" width="262" height="200" rx="46" fill="url(#chromeV)" />
      <rect x="88" y="84" width="186" height="9" rx="4.5" fill="#1b1b1a" />
      <rect class="glow" x="88" y="80" width="186" height="34" rx="6" fill="url(#glowG)" />
      <rect x="80" y="104" width="7" height="160" rx="3.5" fill="#fff" opacity=".45" filter="url(#sblur)" />
      <rect x="268" y="104" width="5" height="150" rx="2.5" fill="#fff" opacity=".35" filter="url(#sblur)" />
      <text x="181" y="146" text-anchor="middle" class="plate">be like josé</text>
      <text x="181" y="160" text-anchor="middle" class="plate2">TOSTADORA · MOD. 04</text>
      <rect x="60" y="270" width="242" height="18" rx="7" fill="#1d1d1c" />
      <rect x="78" y="286" width="26" height="8" rx="2" fill="#111" /><rect x="258" y="286" width="26" height="8" rx="2" fill="#111" />

      <!-- browning knob -->
      <g class="knob-labels">{levels.map((l, i) => { const p = lab(angles[i]); return <text class="klab" data-level={i} x={p.x} y={p.y} text-anchor={angles[i] < 0 ? 'end' : 'start'}>{l}</text>; })}</g>
      <g class="knob" id="knob" style={`transform:rotate(${angles[0]}deg);transform-origin:${kx}px ${ky}px`}>
        <circle cx={kx} cy={ky} r={kr + 3} fill="#2a2a29" />
        <circle cx={kx} cy={ky} r={kr} fill="url(#knobG)" />
        <rect x={kx - 2} y={ky - kr + 3} width="4" height="12" rx="2" fill="#222" />
      </g>

      <!-- lever -->
      <rect x="312" y="128" width="9" height="128" rx="4.5" fill="#1d1d1c" />
      <g class="lever" id="lever"><rect x="306" y="124" width="40" height="18" rx="7" fill="#111" /><rect x="310" y="127" width="30" height="4" rx="2" fill="#fff" opacity=".18" /></g>
    </svg>
    <div class="obj-card" id="toastCard" style="right:2%;bottom:6%"><b>Baja la palanca.</b><i>primero elige el tostado.</i></div>
  </div>
  <p class="ficha"><span class="n">fig. 003</span><br /><b>Tostadora</b>, 2026.<br />Acero, pan y demasiadas horas.<br />— Colección be like josé</p>
  <a class="obj-link" href="/mi-sistema#eje-02">así se ve cuando la operación no te sostiene → eje 02</a>
</div>

<style>
  .toaster { width: 100%; max-width: 340px; overflow: visible; user-select: none; }
  .bread { transform: translateY(0); transition: transform .5s cubic-bezier(.3, 1.6, .5, 1); }
  .toaster-obj.down .bread { transform: translateY(58px); transition: transform .35s cubic-bezier(.6, 0, .9, .5); }
  .toaster-obj.popped .bread { transform: translateY(-34px); }
  .crumb { transition: fill .2s, stroke .2s; }
  .lever { transition: transform .3s cubic-bezier(.3, 1.4, .5, 1); cursor: pointer; }
  .toaster-obj.down .lever { transform: translateY(104px); transition: transform .25s ease-in; }
  .knob { transition: transform .45s cubic-bezier(.3, 1.5, .5, 1); cursor: pointer; }
  .klab { font: 500 8.5px 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .04em; fill: #3a3a38; cursor: pointer; }
  .klab.on { fill: #000; font-weight: 700; text-decoration: underline; }
  .plate { font: italic 17px 'Instrument Serif', serif; fill: #4a4a47; opacity: .7; }
  .plate2 { font: 500 6.5px 'IBM Plex Mono', monospace; letter-spacing: .14em; fill: #4a4a47; opacity: .6; }
  .glow { opacity: 0; transition: opacity .6s; mix-blend-mode: screen; }
  .toaster-obj.down .glow { opacity: 1; animation: hum 1.1s ease-in-out infinite alternate; }
  @keyframes hum { to { opacity: .55; } }
  .burnword { font: italic 26px 'Instrument Serif', serif; fill: #7a5236; opacity: 0; }
  .toaster-obj.burnt .burnword { opacity: 1; }
  .smoke circle { opacity: 0; }
  .toaster-obj.burnt .smoke circle { animation: smoke 2.6s ease-out infinite; }
  @keyframes smoke { 0% { opacity: 0; transform: translate(0, 30px) scale(.6); } 25% { opacity: .55; } 100% { opacity: 0; transform: translate(12px, -70px) scale(1.8); } }
  .obj-link { font-family: 'IBM Plex Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; text-decoration: underline; text-underline-offset: 3px; margin-top: 8px; display: inline-block; color: #444; }
</style>

<script>
  const root = document.getElementById('toaster')!;
  const card = document.getElementById('toastCard')!;
  const knob = document.getElementById('knob')!;
  const crumbs = [...root.querySelectorAll<SVGPathElement>('.crumb')];
  const labels = [...root.querySelectorAll<SVGTextElement>('.klab')];
  const ANG = [-110, -38, 38, 110];
  const TIME = [1800, 2300, 3000, 3900];
  // crumb / crust colour per result
  const COLOR = [['#d7a05a', '#93582a'], ['#e6c78f', '#b9844a'], ['#8c5126', '#5a2f13'], ['#2c1c13', '#120b07']];
  const RAW = ['#efdcb4', '#c99a5e'];
  const RESULT = [
    '<b>En su punto.</b><i>dirección, sistema y descanso.</i>',
    '<b>A medias.</b><i>sin sistema, cada día sale distinto.</i>',
    '<b>Pasado.</b><i>trabajar más no es trabajar mejor.</i>',
    '<b>Burnout.</b><i>más horas no es más dirección.</i>',
  ];
  let level = 0, busy = false;

  const ac = () => ((window as any).__ac ||= new (window.AudioContext || (window as any).webkitAudioContext)());
  const beep = (f: number, d: number, type: OscillatorType = 'sine', v = .2, at = 0) => {
    try { const A = ac(), t = A.currentTime + at, o = A.createOscillator(), g = A.createGain(); o.type = type; o.frequency.value = f; g.gain.setValueAtTime(v, t); g.gain.exponentialRampToValueAtTime(.0001, t + d); o.connect(g).connect(A.destination); o.start(t); o.stop(t + d + .02); } catch (e) { /* audio optional */ }
  };
  const tick = () => beep(2400, .025, 'square', .05);
  const clunk = () => { beep(110, .14, 'triangle', .35); beep(700, .04, 'square', .06); };
  const ding = () => { beep(1318, 1.4, 'sine', .22); beep(2636, .8, 'sine', .06); };

  const setCard = (html: string) => { card.classList.remove('swap'); void card.offsetWidth; card.classList.add('swap'); setTimeout(() => (card.innerHTML = html), 180); };
  const paint = ([crumb, crust]: string[]) => crumbs.forEach((c) => { c.setAttribute('fill', crumb); c.setAttribute('stroke', crust); });
  const setLevel = (l: number) => {
    if (busy) return;
    level = l; knob.style.transform = `rotate(${ANG[l]}deg)`; tick();
    labels.forEach((t) => t.classList.toggle('on', Number(t.dataset.level) === l));
    if (!root.classList.contains('popped')) setCard(`<b>${['Con dirección.', 'A ojo.', 'Todo el día.', 'Sin parar.'][l]}</b><i>ahora baja la palanca.</i>`);
  };
  setLevel(0);

  function toast() {
    if (busy) return; busy = true;
    root.classList.remove('popped', 'burnt'); paint(RAW);
    requestAnimationFrame(() => root.classList.add('down'));
    clunk(); setCard('<b>Tostando…</b><i>tic, tac.</i>');
    const tk = setInterval(tick, 260);
    setTimeout(() => {
      clearInterval(tk); paint(COLOR[level]);
      root.classList.remove('down'); root.classList.add('popped'); if (level === 3) root.classList.add('burnt');
      ding(); setCard(RESULT[level]); busy = false;
    }, TIME[level]);
  }

  knob.addEventListener('click', () => setLevel((level + 1) % 4));
  labels.forEach((t) => t.addEventListener('click', () => setLevel(Number(t.dataset.level))));
  root.querySelector('#lever')!.addEventListener('click', toast);
  root.querySelector('.toaster')!.addEventListener('click', (e) => { if (!(e.target as Element).closest('#knob,.klab,#lever')) toast(); });
</script>
