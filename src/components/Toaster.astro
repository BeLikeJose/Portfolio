---
// Tostadora con dos clips reales: mismo pan, misma tostadora; cambia cómo trabajas.
// "con dirección" → sale dorada; "sin dirección" → sale quemada. Videos en /media/tostadora (fondo igualado a la web).
const M = '/media/tostadora';
const POP_AT = 4.1; // segundo del clip en que salta la tostada
---
<div class="obj toaster-obj" id="toaster" data-pop={POP_AT}>
  <div class="obj-stage">
    <div class="toast-box" id="toastBox" role="img" aria-label="tostadora">
      <img class="tv on" id="tvRest" src={`${M}/reposo.jpg`} alt="" />
      <video class="tv" id="tvGold" src={`${M}/dorada.mp4`} poster={`${M}/reposo.jpg`} playsinline preload="auto"></video>
      <video class="tv" id="tvBurn" src={`${M}/quemada.mp4`} poster={`${M}/reposo.jpg`} playsinline preload="auto"></video>
    </div>
    <div class="obj-card" id="toastCard"><b>Elige cómo trabajas.</b><i>y baja la palanca.</i></div>
  </div>
  <div class="toast-choices" id="toastChoices">
    <button type="button" data-v="gold">con dirección</button>
    <button type="button" data-v="burn">sin dirección</button>
    <button type="button" class="obj-reset" id="toastReset" hidden>↺ otra vez</button>
  </div>
  <p class="ficha"><span class="n">fig. 003</span><br /><b>Tostadora</b>, 2026.<br />Acero, pan y demasiadas horas.<br />— Colección be like josé</p>
  <a class="obj-link" href="/mi-sistema#eje-02">así se ve cuando la operación no te sostiene → eje 02</a>
</div>

<style>
  .toast-box { position: relative; width: 100%; max-width: 440px; aspect-ratio: 720 / 634; cursor: pointer; }
  .tv { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity .15s; pointer-events: none;
    --fx: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); --fy: linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: var(--fx), var(--fy); -webkit-mask-composite: source-in; mask-image: var(--fx), var(--fy); mask-composite: intersect; }
  .tv.on { opacity: 1; }
  .tv { mix-blend-mode: multiply; } /* el fondo blanco del video desaparece contra la página */
  #toastCard { right: 0; bottom: 8%; }
  .toast-choices { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 6px; }
  .toast-choices button[data-v] { font: 500 11px 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .05em; background: none; border: 1px solid var(--ink); border-radius: 999px; padding: 10px 16px; cursor: pointer; color: var(--ink); transition: background .2s, color .2s; }
  .toast-choices button[data-v]:hover, .toast-choices button[data-v].on { background: var(--ink); color: #fafafa; }
  .toast-choices button[data-v]:disabled { opacity: .35; cursor: default; }
  .toast-choices .obj-reset { margin: 0 0 0 4px; }
  .obj-link { font-family: 'IBM Plex Mono', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; text-decoration: underline; text-underline-offset: 3px; margin-top: 8px; display: inline-block; color: #444; }
  @media (max-width: 900px) { .toast-box { max-width: 340px; } #toastCard { bottom: 2%; } }
</style>

<script>
  const root = document.getElementById('toaster')!;
  const POP_AT = Number(root.dataset.pop);
  const rest = document.getElementById('tvRest')!;
  const clips = { gold: document.getElementById('tvGold') as HTMLVideoElement, burn: document.getElementById('tvBurn') as HTMLVideoElement };
  const card = document.getElementById('toastCard')!;
  const choices = [...root.querySelectorAll<HTMLButtonElement>('button[data-v]')];
  const resetBtn = document.getElementById('toastReset')!;
  const RESULT = {
    gold: '<b>En su punto.</b><i>mismo pan, mismas horas. esta vez con dirección.</i>',
    burn: '<b>Se quemó.</b><i>no le faltó tiempo, le faltó dirección.</i>',
  };
  let busy = false;

  const setCard = (html: string) => { card.classList.remove('swap'); void card.offsetWidth; card.classList.add('swap'); setTimeout(() => (card.innerHTML = html), 180); };
  const show = (el: Element) => [rest, clips.gold, clips.burn].forEach((x) => x.classList.toggle('on', x === el));

  function run(v: 'gold' | 'burn') {
    if (busy) return; busy = true;
    const clip = clips[v];
    choices.forEach((b) => { b.disabled = true; b.classList.toggle('on', b.dataset.v === v); });
    clip.currentTime = 0; clip.muted = false; clip.volume = 0.6;
    const go = () => { show(clip); setCard('<b>Tostando…</b><i>tic, tac.</i>'); };
    clip.play().then(go).catch(() => { clip.muted = true; clip.play().then(go).catch(() => {}); });
    let shown = false;
    const onTime = () => { if (!shown && clip.currentTime >= POP_AT) { shown = true; setCard(RESULT[v]); } };
    clip.addEventListener('timeupdate', onTime);
    clip.addEventListener('ended', () => { clip.removeEventListener('timeupdate', onTime); if (!shown) setCard(RESULT[v]); resetBtn.hidden = false; busy = false; choices.forEach((b) => (b.disabled = false)); }, { once: true });
  }

  function reset() {
    Object.values(clips).forEach((c) => { c.pause(); c.currentTime = 0; });
    show(rest); resetBtn.hidden = true; busy = false;
    choices.forEach((b) => { b.disabled = false; b.classList.remove('on'); });
    setCard('<b>Elige cómo trabajas.</b><i>y baja la palanca.</i>');
  }

  choices.forEach((b) => b.addEventListener('click', () => { if (!resetBtn.hidden) reset(); run(b.dataset.v as 'gold' | 'burn'); }));
  resetBtn.addEventListener('click', reset);
  document.getElementById('toastBox')!.addEventListener('click', () => { if (!busy && resetBtn.hidden) setCard('<b>Elige cómo trabajas.</b><i>abajo: con dirección o sin dirección.</i>'); });
</script>
