---
// Una pestaña de La obra: el caso con orden más bajo va en grande; el resto, al lado.
// Los datos salen de src/content/obra/<pestaña>/*.yaml (se editan en /keystatic).
import Ficha from './Ficha.astro';
interface Caso { titulo: string; etiquetas: string[]; portada?: string | null; video?: string | null; orden: number; [k: string]: unknown }
interface Props { casos: Caso[]; campos: [string, string][]; intro?: string; scene: string; tone?: string }
const { casos, campos, intro, scene, tone } = Astro.props;
const [main, ...rest] = [...casos].sort((a, b) => a.orden - b.orden);
const ficha = (c: Caso) => campos.map(([k, label]) => [label, String(c[k] ?? '')] as [string, string]);
const lista = campos.map(([, l]) => l.toLowerCase());
const resumen = lista.slice(0, -1).join(', ') + ' y ' + lista.at(-1) + '.';
const SCENES = ['street', 'sky', 'flash', 'lamp', 'park', 'hands'];
// Un .mp4/.webm/.mov se reproduce en la página; cualquier otro link (Instagram, YouTube…) abre aparte.
const esArchivo = (u?: string | null) => !!u && /\.(mp4|webm|mov)(\?|#|$)/i.test(u);
---
{intro && <p class="tab-intro">{intro}</p>}
{main && (
  <div class="mgrid">
    <div class="feature">
      {esArchivo(main.video) && main.portada ? <div class="film real playable"><img src={main.portada} alt={main.titulo} loading="lazy" /><video src={main.video!} playsinline preload="none"></video><button type="button" class="ver-video mono" data-play>▶ ver video</button></div>
        : esArchivo(main.video) ? <div class="film real"><video src={main.video!} autoplay muted loop playsinline></video></div>
        : main.portada ? <div class="film real"><img src={main.portada} alt={main.titulo} loading="lazy" />{main.video && <a class="ver-video mono" href={main.video} target="_blank" rel="noopener">▶ ver video</a>}</div>
        : <div class="film" data-scene={scene} data-seed="19" data-tone={tone} data-video>{main.video && <a class="ver-video mono" href={main.video} target="_blank" rel="noopener">▶ ver video</a>}</div>}
      <div class="cap"><div>{main.etiquetas.map((t) => <span class="tag">{t}</span>)}<div class="h3">{main.titulo}</div></div><Ficha items={ficha(main)} /></div>
    </div>
    {rest.length ? (
      <div class="side-list">
        {rest.map((c, i) => (
          <div class="side-item">
            {esArchivo(c.video) && c.portada ? <div class="film real playable"><img src={c.portada} alt={c.titulo} loading="lazy" /><video src={c.video!} playsinline preload="none"></video><button type="button" class="ver-video mono" data-play>▶</button></div>
              : esArchivo(c.video) ? <div class="film real"><video src={c.video!} autoplay muted loop playsinline></video></div>
              : c.portada ? <div class="film real"><img src={c.portada} alt={c.titulo} loading="lazy" />{c.video && <a class="ver-video mono" href={c.video} target="_blank" rel="noopener">▶</a>}</div>
              : <div class="film" data-scene={SCENES[i % SCENES.length]} data-seed={30 + i} data-tone={tone}>{c.video && <a class="ver-video mono" href={c.video} target="_blank" rel="noopener">▶</a>}</div>}
            <div>{c.etiquetas.map((t) => <span class="tag">{t}</span>)}<div class="h3">{c.titulo}</div><Ficha items={ficha(c)} /></div>
          </div>
        ))}
      </div>
    ) : (
      <div class="feature-aside"><span class="mono">cada caso, la misma ficha</span><p>{resumen.charAt(0).toUpperCase() + resumen.slice(1)}</p><a class="wbtn" href="/contacto#agenda">Charlemos →</a></div>
    )}
  </div>
)}

<style is:global>
  /* un video propio con portada: se ve la portada y, al tocar, se reproduce con sonido (el video puede ser vertical) */
  .mgrid .film.real.playable:not(.playing) video { display: none; }
  .mgrid .film.real.playable.playing video { display: block; width: auto; max-width: 100%; }
  .film.playable.playing img, .film.playable.playing [data-play] { display: none; }
  .film.playable [data-play] { border: 0; cursor: pointer; font-family: 'IBM Plex Mono', monospace; }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('[data-play]');
    if (!btn) return;
    const box = btn.closest('.playable') as HTMLElement;
    const v = box.querySelector('video') as HTMLVideoElement;
    box.classList.add('playing'); v.controls = true; v.muted = false; v.volume = 0.8;
    v.play().catch(() => { v.muted = true; v.play().catch(() => {}); });
    v.addEventListener('ended', () => { box.classList.remove('playing'); v.controls = false; v.currentTime = 0; }, { once: true });
  });
</script>
