---
// Una pestaña de La obra: un índice de portadas. Cada tarjeta abre la página del caso.
// El caso con orden más bajo va destacado; los demás, en columnas (cada portada con su proporción).
import { TABS, esArchivo, vt, type Caso, type Tab } from '../lib/obra';
interface Props { casos: Caso[]; tab: Tab; intro?: string }
const { casos, tab, intro } = Astro.props;
const { scene, tone } = TABS[tab];
const [main, ...rest] = casos;
const tieneVideo = (c: Caso) => !!c.video || c.galeria.some((g) => g.video);
const piezas = (c: Caso) => c.galeria.length + (c.portada || c.video ? 1 : 0);
---
{intro && <p class="tab-intro">{intro}</p>}
{main ? (
  <div class="obra-index">
    <a class="ccard ccard-main" href={main.url}>
      <div class="cmedia" style={`view-transition-name:${vt(main)}`}>
        {main.portada ? <img src={main.portada} alt={main.titulo} loading="lazy" />
          : esArchivo(main.video) ? <video src={`${main.video}#t=0.1`} muted playsinline preload="metadata"></video>
          : <div class="film" data-scene={scene} data-seed="19" data-tone={tone}></div>}
        {tieneVideo(main) && <span class="cbadge mono">▶ video</span>}
      </div>
      <div class="ctext">
        <div>{main.etiquetas.map((t) => <span class="tag">{t}</span>)}</div>
        <h3 class="ctitle">{main.titulo}</h3>
        {main.resumen && <p class="cres">{main.resumen}</p>}
        <span class="cmore mono">ver el caso{piezas(main) > 1 ? ` · ${piezas(main)} piezas` : ''} →</span>
      </div>
    </a>
    {rest.length > 0 && (
      <div class="cgrid">
        {rest.map((c, i) => (
          <a class="ccard" href={c.url}>
            <div class="cmedia" style={`view-transition-name:${vt(c)}`}>
              {c.portada ? <img src={c.portada} alt={c.titulo} loading="lazy" />
                : esArchivo(c.video) ? <video src={`${c.video}#t=0.1`} muted playsinline preload="metadata"></video>
                : <div class="film" data-scene={['street', 'sky', 'flash', 'lamp', 'park', 'hands'][i % 6]} data-seed={30 + i} data-tone={tone}></div>}
              {tieneVideo(c) && <span class="cbadge mono">▶</span>}
            </div>
            <div>{c.etiquetas.map((t) => <span class="tag">{t}</span>)}</div>
            <h3 class="ctitle">{c.titulo}</h3>
            <span class="cmore mono">ver el caso →</span>
          </a>
        ))}
      </div>
    )}
  </div>
) : null}

<style is:global>
  .obra-index { display: flex; flex-direction: column; gap: 56px; }
  .ccard { display: block; color: inherit; text-decoration: none; }
  .ccard-main { display: grid; grid-template-columns: 1.6fr 1fr; gap: 36px; align-items: end; }
  .cmedia { position: relative; overflow: hidden; background: var(--paper); }
  .cmedia img, .cmedia video { display: block; width: 100%; height: auto; max-height: 72vh; object-fit: contain; transition: transform .7s cubic-bezier(.16, 1, .3, 1); }
  .ccard:hover .cmedia img, .ccard:hover .cmedia video { transform: scale(1.025); }
  .cmedia .film { height: 300px; }
  .ccard-main .cmedia .film { height: 460px; }
  .cbadge { position: absolute; left: 12px; bottom: 12px; background: #fafafa; color: var(--ink); padding: 6px 10px; border-radius: 999px; font-size: 10px; line-height: 1.2; }
  .ctext { border-top: 1px solid var(--ink); padding-top: 16px; }
  .ctitle { font-family: 'Instrument Serif', serif; font-weight: 400; font-size: clamp(22px, 1.9vw, 28px); line-height: 1.05; margin: 6px 0 10px; }
  .ccard-main .ctitle { font-size: clamp(30px, 3vw, 46px); }
  .cres { font-size: 14px; line-height: 1.5; color: #444; margin-bottom: 18px; max-width: 46ch; }
  .cmore { font-size: 10px; text-transform: uppercase; letter-spacing: .05em; text-decoration: underline; text-underline-offset: 3px; }
  .cgrid { columns: 3; column-gap: 28px; }
  .cgrid .ccard { break-inside: avoid; margin-bottom: 40px; }
  .cgrid .cmedia { margin-bottom: 14px; }
  @media (max-width: 900px) {
    .ccard-main { grid-template-columns: 1fr; gap: 18px; }
    .ccard-main .cmedia .film { height: 70vw; }
    .cgrid { columns: 2; column-gap: 16px; }
  }
  @media (max-width: 560px) { .cgrid { columns: 1; } .cmedia .film { height: 60vw; } }
</style>
