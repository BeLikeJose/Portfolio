---
// How the four axes feed each other: a loop around the brand. Hover a node or an arrow to read the link.
const N = [
  { n: '01', t: 'Dirección creativa', x: 300, y: 70 },
  { n: '02', t: 'Operaciones y oferta de valor', x: 530, y: 300 },
  { n: '03', t: 'Proyección empresarial', x: 300, y: 530 },
  { n: '04', t: 'Creación de contenidos', x: 70, y: 300 },
];
const LINKS = [
  'La mirada define qué vendes y cómo se siente comprarlo.',
  'La oferta pone números: a dónde vamos y cuánto cuesta llegar.',
  'La meta ordena el calendario: qué se publica, cuándo y para qué.',
  'Lo que la gente responde afina la mirada. Y el ciclo vuelve a empezar.',
];
const arc = (a: typeof N[0], b: typeof N[0]) => { const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2; const cx = mx + (mx - 300) * .55, cy = my + (my - 300) * .55; return `M${a.x + (b.x - a.x) * .2} ${a.y + (b.y - a.y) * .2} Q${cx} ${cy} ${a.x + (b.x - a.x) * .8} ${a.y + (b.y - a.y) * .8}`; };
---
<div class="loop" id="loop">
  <svg viewBox="0 0 600 600" aria-label="cómo se integran los cuatro ejes">
    <defs><marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="currentColor" /></marker></defs>
    <circle cx="300" cy="300" r="210" fill="none" stroke="var(--line)" stroke-dasharray="3 6" />
    {N.map((a, i) => <path class="lk" data-i={i} d={arc(a, N[(i + 1) % 4])} marker-end="url(#ah)" />)}
    <g class="core"><circle cx="300" cy="300" r="78" /><text x="300" y="294" text-anchor="middle" class="ct">tu marca</text><text x="300" y="318" text-anchor="middle" class="cs">en el centro</text></g>
    {N.map((a, i) => (
      <g class="nd" data-i={i}>
        <circle cx={a.x} cy={a.y} r="56" />
        <text x={a.x} y={a.y - 6} text-anchor="middle" class="nn">{a.n}</text>
        <text x={a.x} y={a.y + 16} text-anchor="middle" class="nt">{a.t.split(' ')[0]}</text>
      </g>))}
  </svg>
  <div class="loop-read">
    <span class="mono" id="loopStep">01 → 02</span>
    <p id="loopTxt">{LINKS[0]}</p>
    <div class="loop-dots">{LINKS.map((_, i) => <button data-i={i} class:list={{ on: i === 0 }} aria-label={`paso ${i + 1}`}></button>)}</div>
  </div>
</div>

<style>
  .loop { display: grid; grid-template-columns: minmax(0, 560px) minmax(0, 420px); justify-content: space-between; gap: 60px; align-items: center; }
  svg { width: 100%; max-width: 520px; overflow: visible; color: var(--ink); }
  .lk { fill: none; stroke: #bbb; stroke-width: 2; transition: stroke .3s, stroke-width .3s; cursor: pointer; color: #bbb; }
  .lk.on { stroke: var(--ink); stroke-width: 3; color: var(--ink); stroke-dasharray: 8 6; animation: flow 1s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -14; } }
  .core circle { fill: var(--ink); }
  .ct { font: italic 26px 'Instrument Serif', serif; fill: #fafafa; }
  .cs { font: 500 9px 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .08em; fill: #bdbdb8; }
  .nd { cursor: pointer; }
  .nd circle { fill: var(--w); stroke: var(--ink); stroke-width: 1.2; transition: fill .3s; }
  .nd.on circle { fill: var(--g1); stroke-width: 2.4; }
  .nn { font: 400 30px 'Instrument Serif', serif; fill: var(--ink); }
  .nt { font: 600 10px 'Inter Tight', sans-serif; text-transform: uppercase; letter-spacing: .04em; fill: var(--ink); }
  .loop-read { border-top: 1px solid var(--ink); padding-top: 16px; }
  .loop-read p { font-family: 'Instrument Serif', serif; font-size: 32px; line-height: 1.08; margin-top: 10px; min-height: 140px; }
  .loop-dots { display: flex; gap: 8px; margin-top: 18px; }
  .loop-dots button { width: 34px; height: 4px; border: 0; background: #ccc; padding: 0; cursor: pointer; }
  .loop-dots button.on { background: var(--ink); }

  @media (max-width: 900px) {
    .loop { grid-template-columns: 1fr; gap: 26px; }
    svg { max-width: 420px; margin: 0 auto; display: block; }
    .loop-read p { font-size: 24px; min-height: 110px; }
  }
</style>

<script define:vars={{ LINKS }}>
  const root = document.getElementById('loop');
  const lks = [...root.querySelectorAll('.lk')], nds = [...root.querySelectorAll('.nd')], dots = [...root.querySelectorAll('.loop-dots button')];
  let cur = 0, timer;
  const show = (i) => {
    cur = i;
    lks.forEach((l, k) => l.classList.toggle('on', k === i));
    nds.forEach((n, k) => n.classList.toggle('on', k === i || k === (i + 1) % 4));
    dots.forEach((d, k) => d.classList.toggle('on', k === i));
    document.getElementById('loopStep').textContent = `0${i + 1} → 0${(i + 1) % 4 + 1}`;
    document.getElementById('loopTxt').textContent = LINKS[i];
  };
  const auto = () => { clearInterval(timer); timer = setInterval(() => show((cur + 1) % 4), 4200); };
  [...lks, ...nds, ...dots].forEach((el) => ['mouseenter', 'click'].forEach((ev) => el.addEventListener(ev, () => { show(+el.dataset.i); auto(); })));
  dots.forEach((d) => d.addEventListener('click', () => { show(+d.dataset.i); auto(); }));
  show(0); auto();
</script>
