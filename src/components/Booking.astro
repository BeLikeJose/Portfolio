---
// Google Calendar appointment page. Full ".../appointments/schedules/..." URLs are embedded;
// short calendar.app.google links (not embeddable) open in a new tab.
interface Props { url?: string; length: string; note?: string }
const { url = '', length, note } = Astro.props;
const embed = url.includes('/appointments/schedules/') ? `${url}${url.includes('?') ? '&' : '?'}gv=true` : '';
---
{embed ? (
  <div class="bk-frame"><iframe title={`Agendar ${length}`} src={embed} loading="lazy"></iframe></div>
) : url ? (
  <div class="bk-card">
    <div><span class="mono">google calendar · google meet</span><b>{length}</b><p>{note || 'Eliges día y hora en mi calendario. Te llega la invitación con el link de Google Meet a tu correo.'}</p></div>
    <a class="wbtn" href={url} target="_blank" rel="noopener">elegir día y hora →</a>
  </div>
) : (
  <div class="bk-card"><p>Esta agenda todavía no está activa.</p></div>
)}

<style>
  .bk-frame { border-top: 1px solid var(--ink); }
  .bk-frame iframe { width: 100%; height: 760px; border: 0; display: block; background: #fff; }
  .bk-card { display: flex; justify-content: space-between; align-items: center; gap: 30px; border-top: 1px solid var(--ink); padding: 30px 0; }
  .bk-card .mono { color: #777; }
  .bk-card b { display: block; font: 400 clamp(40px, 5vw, 64px) 'Instrument Serif', serif; line-height: 1; margin: 8px 0 10px; }
  .bk-card p { font-size: 16px; line-height: 1.5; color: #444; max-width: 480px; }
  .bk-card .wbtn { margin: 0; white-space: nowrap; }
  @media (max-width: 900px) { .bk-card { flex-direction: column; align-items: flex-start; } .bk-frame iframe { height: 900px; } }
</style>
