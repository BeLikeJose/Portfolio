---
import Base from '../layouts/Base.astro';
import Compass from '../components/Compass.astro';
import Toaster from '../components/Toaster.astro';
import EditorialCalendar from '../components/EditorialCalendar.astro';
import Roadmap from '../components/Roadmap.astro';
import Media from '../components/Media.astro';
// import LeadMagnet from '../components/LeadMagnet.astro'; // oculto hasta que exista el PDF
import Faq from '../components/Faq.astro';
const CH = [
  ['01', 'Los cuatro ejes', '#ejes'], ['02', 'El proceso por dentro', '#proceso'], ['03', 'Calendarios y roadmaps', '#por-dentro'],
  ['04', 'Lo que pasa sin sistema', '#sin-sistema'], ['05', 'Formas de trabajar', '#contigo'], ['06', 'Preguntas frecuentes', '#preguntas'],
];
const STEPS = [
  { n: '01', t: 'Propuesta', d: 'antes de empezar', p: 'Definimos alcance, tiempos e inversión según lo que necesites.', g: 'una propuesta clara' },
  { n: '02', t: 'Diagnóstico', d: 'semana 1', p: 'Entro a tu negocio: métricas, alcance, dirección, procesos y lo que vendes.', g: 'diagnóstico por eje' },
  { n: '03', t: 'Dirección', d: 'semana 2', p: 'Diseño la dirección creativa, la oferta y la estructura: los cuatro ejes, listos para ejecutar.', g: 'roadmap de lo que vamos a ejecutar y llevar a cabo' },
  { n: '04', t: 'Roadmap', d: 'semana 2', p: 'Ordenamos el roadmap de 90 días: metas, oferta, pilares y calendario.', g: 'roadmap y calendario' },
  { n: '05', t: 'Ejecución o acompañamiento', d: 'semanas 3 – 10', p: 'Si sumas ejecución, la dirijo y la coordino, con mi equipo creativo o con el tuyo. Si la ejecuta tu equipo, la acompaño con sesiones de seguimiento a convenir. Cada semana sabes en qué vamos.', g: 'piezas publicadas o acompañamiento semanal' },
  { n: '06', t: 'Lectura', d: 'semanas 11 – 12', p: 'Leemos los números de verdad, ajustamos y decidimos juntos cómo seguimos.', g: 'reporte y siguiente paso' },
];
---
<Base title="Cómo trabajo — Be like José" description="Cuatro ejes, un primer ciclo de 90 días y después Plan mensual. Así se vive por dentro trabajar conmigo.">
<main class="page sys">

<section class="sys-hero">
  <div class="mono" style="color:#777">03 — mi sistema</div>
  <h1 class="disp" data-r>Mi <em>sistema</em></h1>
  <div class="sys-hero-row">
    <p class="sys-lead" data-r>Cuatro ejes que casi nunca trabajan juntos, en una sola dirección.</p>
    <ol class="chapters" data-r>{CH.map(([n, t, h]) => <li><a href={h}><span class="mono">{n}</span>{t}<em>↓</em></a></li>)}</ol>
  </div>
</section>

<section class="ejes" id="ejes">
  <div class="ejes-head">
    <div class="mono" style="color:#777">capítulo 01 — los cuatro ejes</div>
    <h2 class="disp" data-r>Cuatro ejes,<br><em>una sola dirección</em></h2>
    <div class="ejes-side">
      <p data-r>Con estos cuatro ejes construyo todo: lo que tu marca dice, lo que vende, hacia dónde va y cómo se sostiene sin quemarte la cabeza.</p>
      <Compass />
    </div>
  </div>
  <div class="ejes-grid" data-r>
    <article id="eje-01"><span class="n">01</span><h3>Dirección creativa</h3><p>La mirada. Conceptos, campañas y una estética que se reconoce sin ver el logo.</p><div class="mono tags">identidad de marca · branding · naming · concepto creativo · tono y voz · campañas</div></article>
    <article id="eje-02"><span class="n">02</span><h3>Operaciones y oferta de valor</h3><p>Qué vendes, a quién y el sistema que lo sostiene. Para que el negocio no dependa de que trabajes sin parar.</p><div class="mono tags">propuesta de valor · pricing · proceso de compra · onboarding de clientes · automatizaciones</div></article>
    <article id="eje-03"><span class="n">03</span><h3>Proyección empresarial</h3><p>Hacia dónde va el negocio. Metas claras, números que puedes revisar cada mes y un roadmap de 90 días.</p><div class="mono tags">posicionamiento · KPIs · roadmap de 90 días · planeación comercial · lanzamientos</div></article>
    <article id="eje-04"><span class="n">04</span><h3>Creación de contenidos</h3><p>Piezas que se guardan y se comparten. Film, edición y un calendario editorial con mirada propia.</p><div class="mono tags">estrategia de contenidos · calendario editorial · guiones · rodaje · edición · publicación</div></article>
  </div>
</section>

<section class="sys-sec dark" id="proceso">
  <div class="film" data-scene="lamp" data-seed="22" data-video></div>
  <div class="sys-head"><div class="mono">capítulo 02 — el proceso por dentro</div><h2 class="disp" data-r>Así se vive <em>desde adentro</em></h2><p data-r>El primer ciclo: 12 semanas, del diagnóstico a decidir juntos cómo seguimos. Siempre sabes en qué vamos y qué viene.</p></div>
  <p class="step-zero" data-r><span class="mono">paso 0 · la charla</span>Antes de cualquier proceso hay una charla de 30 minutos para conocernos: me encanta conocer a quien está creando algo. Si luego queremos trabajar juntos, empieza esto.</p>
  <p class="swipe-hint mono">desliza para ver los 6 pasos →</p>
  <ol class="steps" data-r>{STEPS.map((s) => <li><span class="sn">{s.n}</span><span class="mono sd">{s.d}</span><h3>{s.t}</h3><p>{s.p}</p><span class="mono sg">recibes → {s.g}</span></li>)}</ol>
</section>

<section class="sys-sec" id="por-dentro">
  <div class="sys-head"><div class="mono">capítulo 03 — calendarios y roadmaps</div><h2 class="disp" data-r>Todo en papel <em>antes de grabar</em></h2><p data-r>Un mes de mi propio calendario. Lo que hago para mí es lo que hago para ti. Filtra por pilar o mueve la semana del roadmap.</p></div>
  <div class="tools">
    <EditorialCalendar />
    <Roadmap />
  </div>
</section>

<!-- Capítulo "La mesa de trabajo": se oculta hasta tener el video del Notion, las tarjetas y las fotos de rodaje.
<section class="sys-sec" id="mesa">
  <div class="sys-head"><div class="mono">capítulo 05 — la mesa de trabajo</div><h2 class="disp" data-r>Lo que el cliente <em>ve por dentro</em></h2><p data-r>El Notion donde vive cada proyecto, las tarjetas terminadas, lo que se decide en las reuniones y los rodajes. Sin maquillaje.</p></div>
  <div class="mesa" data-r>
    <div class="m-notion"><Media label="video del Notion del cliente (recorrido)" kind="video" scene="hands" seed="31" cap="el tablero del proyecto — Notion" /></div>
    <div class="m-cards">
      <span class="mono">tarjetas terminadas</span>
      <div class="cards-row">{[1, 2, 3].map((i) => <Media label={`tarjeta ${i} del calendario`} kind="screenshot" scene={['window', 'sofa', 'flash'][i - 1]} seed={i + 40} cap={['guion aprobado', 'pieza editada', 'publicada ✓'][i - 1]} />)}</div>
    </div>
    <div class="m-meets"><div class="m-meet"><Media label="highlight de reunión con cliente" kind="video" scene="lamp" seed="44" cap="reunión de dirección — 2 min" /></div>
    <div class="m-meet"><Media label="highlight de sesión de estrategia" kind="video" scene="studio" seed="45" tone="bw" cap="pizarra y decisiones" /></div></div>
    <div class="m-shoots"><span class="mono">fotos de rodaje</span>
      <div class="shoots">{['street', 'park', 'bokeh', 'flash', 'sky'].map((sc, i) => <Media label={`foto de rodaje ${i + 1}`} scene={sc} seed={60 + i} />)}</div>
    </div>
  </div>
</section>
-->

<section class="sys-sec" id="sin-sistema">
  <div class="sin">
    <div>
      <div class="mono" style="color:#777">capítulo 04 — lo que pasa sin sistema</div>
      <h2 class="disp" data-r>Más horas no es <em>más dirección</em></h2>
      <p class="sys-p" data-r>La mayoría de creadores y negocios que llegan conmigo no tienen un problema de talento ni de ganas. Tienen un problema de sistema: hacen todo, todo el tiempo, y cada pieza sale distinta.</p>
    </div>
    <Toaster />
  </div>
</section>

<section class="sys-sec" id="contigo">
  <div class="sys-head"><div class="mono">capítulo 05 — formas de trabajar</div><h2 class="disp" data-r>Elige por dónde <em>empezamos</em></h2><p data-r>Todo empieza con una charla. Después, si quieres seguir: un servicio principal, una extensión para llevarlo a la práctica y dos formas de resolver una sola pieza.</p></div>

  <div class="svc-main" data-r>
    <article class="svc-hero"><span class="mono">01 · el servicio principal</span><h3>Dirección y estrategia creativa</h3>
      <p>Diseño la dirección creativa, la oferta y la estructura de negocio de tu marca: los cuatro ejes, listos para ejecutar.</p>
      <div class="svc-gets"><span class="mono">recibes</span><ul><li>Dirección creativa: identidad, tono, conceptos, lanzamientos y territorio visual</li><li>Oferta de valor y pricing</li><li>Roadmap de 90 días con metas y KPIs</li><li>Pilares y calendario editorial</li></ul></div>
      <p class="for">Para ti si necesitas saber qué decir, qué vender y hacia dónde ir.</p>
      <span class="mono svc-note">no incluye ejecución</span></article>
    <article class="svc-plus"><span class="mono">+ ejecución · se suma a la dirección</span><h3>Ejecución</h3>
      <p>Dirijo y coordino la ejecución de la estrategia, con mi equipo creativo o con el tuyo.</p>
      <p class="for">Para ti si no quieres coordinar proveedores que no se hablan.</p></article>
  </div>

  <div class="svc-time" data-r>
    <div><span class="mono">el tiempo</span><p class="svc-time-h">Los primeros 90 días son para construir. Lo que venga después, lo decidimos juntos.</p></div>
    <div><b>Primer ciclo · 90 días</b><p>Dirección (y ejecución, si la sumas) con roadmap, calendario y lectura de números al cierre.</p></div>
    <div><b>Plan mensual</b><p>Si ambos estamos felices, seguimos mes a mes: dirección y ejecución recurrentes, con lectura de números y ajuste del roadmap cada trimestre.</p></div>
  </div>

  <div class="svc-pieces" data-r>
    <span class="mono">¿solo necesitas una pieza?</span>
    <div class="svc-row">
      <article><span class="mono">02 · sesión individual o paquete</span><h3>Consultorías</h3><p>Destrabamos lo que te frena: oferta, marca, contenido, números. Tú ejecutas.</p><p class="for">Para ti si ya sabes qué hacer y necesitas una segunda mirada.</p></article>
      <article><span class="mono">03 · filmmaking y edición</span><h3>Producción audiovisual</h3><p>Filmmaking de eventos y edición de contenido, sin estrategia incluida.</p><p class="for">Para ti si ya sabes qué comunicar y necesitas quien lo grabe y lo edite bien.</p></article>
    </div>
  </div>

  <div class="svc-foot" data-r>
    <p><span class="mono">inversión</span>Consultorías y producción se cotizan por proyecto. Para dirección y ejecución, si después de la charla quieres seguir, te envío la inversión por escrito.</p>
    <p><span class="mono">lo que te pido</span>Ganas de charlar, decisiones a tiempo y ganas de comerte el mundo.</p>
    <a class="wbtn" href="/contacto#agenda">Charlemos →</a>
  </div>
</section>
<section class="sys-sec" id="preguntas">
  <div class="sys-head"><div class="mono">capítulo 06 — preguntas frecuentes</div><h2 class="disp" data-r>Antes de <em>la charla</em></h2><p data-r>Lo que casi todos preguntan. Si tu duda no está aquí, la resolvemos en los 30 minutos.</p></div>
  <Faq set="servicio" />
</section>

<section class="final-cta" id="charlemos">
  <div class="mono" style="color:#777">¿no sabes cuál te sirve?</div>
  <h2 class="disp" data-r>Charlemos 30 minutos <em>y lo averiguamos.</em></h2>
  <p class="final-sub" data-r>Crecer es más fácil en compañía.</p>
  <div class="final-row" data-r><div class="final-btn"><a class="wbtn" href="/contacto#agenda">Charlemos →</a><span class="mono cta-note">30 minutos para conocernos y destrabar ideas</span></div></div>
  {/* <LeadMagnet /> oculto hasta que exista el PDF */}
</section>
</main>
</Base>
