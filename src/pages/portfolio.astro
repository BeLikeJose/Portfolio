---
import Base from '../layouts/Base.astro';
import Suitcase from '../components/Suitcase.astro';
import Media from '../components/Media.astro';
import ObraPanel from '../components/ObraPanel.astro';
import { NUMBERS } from '../lib/reach.js';
import { getCollection, getEntry } from 'astro:content';

const pagina = (await getEntry('obraPagina', 'pagina'))?.data;
const data = async (c: 'estratega' | 'editor' | 'filmmaker') => (await getCollection(c)).map((e) => e.data);
const [estratega, editor, filmmaker] = await Promise.all([data('estratega'), data('editor'), data('filmmaker')]);
// Campos de la ficha por pestaña: [clave en el archivo, cómo se muestra].
const CAMPOS = {
  estratega: [['cliente', 'Cliente'], ['contexto', 'Contexto'], ['decision', 'Decisión creativa'], ['construi', 'Lo que construí'], ['resultado', 'Resultado']],
  editor: [['cliente', 'Cliente'], ['material', 'Material de partida'], ['herramientas', 'Herramientas'], ['formato', 'Formato']],
  filmmaker: [['evento', 'Evento'], ['fechaLugar', 'Fecha y lugar'], ['rol', 'Mi rol'], ['formato', 'Formato'], ['mirada', 'Mi mirada']],
} as Record<string, [string, string][]>;
---
<Base title="La obra — Be like José" description="Casos de estrategia, rodaje y edición para marcas personales, empresas y creadores.">
<main class="page">
<section class="mag" id="portfolio" data-tabs>
  <div class="mag-head"><div><div class="mono" style="color:#777;margin-bottom:14px">la obra</div><h2 class="disp">La obra</h2>{pagina?.intro && <p class="mag-sub">{pagina.intro}</p>}</div><a class="seeall" href="/contacto#agenda"><span>¿algo de esto te dio ideas? charlemos</span><b>→</b></a></div>
  <div class="chips"><button data-tab="strat" class="on"><span class="film" data-scene="window" data-seed="8"></span>Estratega creativo</button><button data-tab="film"><span class="film" data-scene="street" data-seed="2"></span>Filmmaker</button><button data-tab="edit"><span class="film" data-scene="studio" data-seed="5" data-tone="bw"></span>Editor</button></div>
  <div class="mpanels">
    <div class="mpanel on" data-panel="strat"><ObraPanel casos={estratega} campos={CAMPOS.estratega} intro={pagina?.introEstratega} scene="window" /></div>
    <div class="mpanel" data-panel="film"><ObraPanel casos={filmmaker} campos={CAMPOS.filmmaker} intro={pagina?.introFilmmaker} scene="street" /></div>
    <div class="mpanel" data-panel="edit"><ObraPanel casos={editor} campos={CAMPOS.editor} intro={pagina?.introEditor} scene="studio" tone="bw" /></div>
  </div>
</section>

<section class="metricas" id="metricas">
  <div class="ex-head"><div><div class="mono" style="color:#777">estratega creativo — resultados para marcas</div><h2 class="disp" data-r>Números <em>que se ven</em></h2></div><p class="maleta-p">Lo que hemos construido con las marcas. Solo números reales.</p></div>
  <div class="big-nums" data-r>{NUMBERS.map((n) => <div><b>{n.prefix}<span data-count={n.value}>{n.value}</span>{n.suffix}</b><span class="mono">{n.label}</span></div>)}</div>

  <p class="swipe-hint mono">desliza →</p>
  <div class="phones" data-r>
    {[['insights de Instagram — cuenta 01', 'alcance 30 días'], ['reel con más vistas', 'vistas · guardados'], ['crecimiento de seguidores', 'antes → después'], ['estadísticas de TikTok / YouTube', 'retención']].map(([l, c], i) => (
      <div class="phone"><Media label={l} kind="screenshot" scene={['bokeh', 'street', 'window', 'lamp'][i]} seed={i + 3} cap={c} /></div>
    ))}
  </div>

  <div class="ba" data-r>
    <div class="ba-h"><span class="mono">caso — antes y después</span><h3>Cuenta 01 <em>· 90 días</em></h3></div>
    <div class="ba-grid">
      <Media label="perfil antes (captura)" kind="screenshot" scene="studio" seed="2" tone="bw" cap="antes" />
      <div class="ba-arrow">→</div>
      <Media label="perfil después (captura)" kind="screenshot" scene="bokeh" seed="5" cap="después" />
      <p class="ba-change"><span class="mono">qué cambió</span>Definimos dos pilares, un plano de firma y un calendario de 12 piezas al mes.</p>
    </div>
  </div>

  <div class="wins" data-r>
    <div><span class="mono">logros</span>
      <ol>
        <li><b>4 países</b><i>Panamá, México, Brasil y Colombia.</i></li>
        <li><b>+8 eventos con marcas</b><i>nacionales e internacionales.</i></li>
        <li><b>Reconocimientos</b><i>Unión Europea en Colombia, Feria Internacional del Libro de Panamá y Sky Experience con Smartfit.</i></li>
      </ol>
    </div>
    <!-- Testimonios: se muestran cuando haya nombre, marca y foto reales (Vanessa, Christian). -->
  </div>
</section>

<section class="maleta" id="maleta">
  <div class="ex-head"><div><div class="mono" style="color:#777">fig. 005 — la maleta</div><h2 class="disp" data-r>Con qué <em>produzco</em></h2></div><p class="maleta-p">Lo que llevo a cada rodaje. Ábrela.</p></div>
  <Suitcase />
</section>

<section class="strip" id="rollo">
  <div class="strip-head"><h3>rollo 01 —<br><span class="it">lo cotidiano también es obra</span></h3><div class="mono" style="opacity:.6;align-self:end">36 exp · iso 800 · revelado a mano</div></div>
  <div class="reel" id="reel"></div>
</section>
<section class="next-cta"><span class="mono">¿te dieron ganas de crear algo parecido?</span><div class="cta-stack"><a class="wbtn" href="/contacto#agenda">Charlemos →</a><span class="mono cta-note">30 minutos para conocernos y destrabar ideas</span></div></section>
</main>
<script slot="scripts" is:inline>
  const sc = ['bokeh', 'park', 'window', 'street', 'lamp', 'sky', 'studio', 'flash', 'sofa', 'hands'];
  const one = i => '<div class="frame"><div class="film" data-scene="' + sc[i % sc.length] + '" data-seed="' + (50 + i) + '" ' + (i % 3 === 0 ? 'data-video' : '') + ' ' + (i % 4 === 1 ? 'data-tone="bw"' : '') + '></div><span class="no">▸ ' + String(i + 1).padStart(2, '0') + 'A &nbsp; KODAK 5219</span></div>';
  const set = Array.from({length: 10}, (_, i) => one(i)).join('');
  document.getElementById('reel').innerHTML = set + set;
  // /portfolio#film, #edit, #strat open that tab
  const openTab = () => { const h = location.hash.slice(1); if (['film', 'edit', 'strat'].includes(h)) { setTab('#portfolio', h); setTimeout(() => window.renderFilms && renderFilms(), 60); document.getElementById('portfolio').scrollIntoView(); } };
  addEventListener('load', openTab); addEventListener('hashchange', openTab);
</script>
</Base>
