---
import Base from '../layouts/Base.astro';
import Suitcase from '../components/Suitcase.astro';
import Media from '../components/Media.astro';
import { NUMBERS } from '../lib/reach.js';
---
<Base title="La obra — Be like José" description="Casos de estrategia, rodaje y edición para marcas personales, empresas y creadores. Qué era, qué decidí y hasta dónde llegó.">
<main class="page">
<section class="mag" id="portfolio" data-tabs>
  <div class="mag-head"><div><div class="mono" style="color:#777;margin-bottom:14px">la obra</div><h2 class="disp">La obra</h2><p class="mag-sub">Estrategia, rodaje y edición, contados como una revista: qué era, qué decidí y hasta dónde llegó.</p></div><a class="seeall" href="/contacto#agenda"><span>¿algo de esto te dio ideas? charlemos</span><b>→</b></a></div>
  <div class="chips"><button data-tab="strat" class="on"><span class="film" data-scene="window" data-seed="8"></span>Estratega creativo</button><button data-tab="film"><span class="film" data-scene="street" data-seed="2"></span>Filmmaker</button><button data-tab="edit"><span class="film" data-scene="studio" data-seed="5" data-tone="bw"></span>Editor</button></div>
  <div class="mpanels">
    <div class="mpanel on" data-panel="strat">
      <p class="tab-intro">La estrategia también es obra. Conceptos, calendarios y roadmaps reales, con lo que lograron.</p>
      <div class="mgrid">
        <div class="feature"><div class="film" data-scene="window" data-seed="19" data-video><div class="demo" style="font-family:'Instrument Serif';font-size:70px;text-align:center;line-height:.95;text-transform:uppercase">el tostador<br>que quema<br><i style="font-size:36px;text-transform:none">= burnout</i></div><div class="lab">concepto — objeto resignificado</div></div>
          <div class="cap"><div><span class="tag">concepto</span><div class="h3">El objeto que habla: conceptos que se entienden en un segundo</div></div><dl class="ficha-dl"><div><dt>La decisión creativa</dt><dd>Un objeto de todos los días que dice otra cosa: el tostador que quema es el burnout.</dd></div><div><dt>Qué hice</dt><dd>Concepto creativo · guion · dirección</dd></div></dl></div></div>
        <div class="side-list">
          <div class="side-item"><div class="film" data-scene="lamp" data-seed="22"><div class="demo"><div class="cal-mini" id="calMini"></div></div></div><div><span class="tag">calendario</span><div class="h3">Mes 1 — 16 piezas, 3 pilares</div><div class="by">calendario editorial</div></div></div>
          <div class="side-item"><div class="film" data-scene="hands" data-seed="7"></div><div><span class="tag">roadmap</span><div class="h3">90 días: esencia, sistema, movimiento</div><div class="by"><a class="lnk" href="/mi-sistema#por-dentro">ver cómo se ve →</a></div></div></div>
          <div class="side-item"><div class="film" data-scene="park" data-seed="5"></div><div><span class="tag">resultados</span><div class="h3">Lo que hemos construido con las marcas</div><div class="by"><a class="lnk" href="#metricas">ver números ↓</a></div></div></div>
        </div>
      </div>
    </div>
    <div class="mpanel" data-panel="film">
      <p class="tab-intro">Eventos, marcas y cuentas que se ven como cine. Rodado en Sony a7 IV y Osmo Pocket 3.</p>
      <div class="mgrid">
        <div class="feature"><div class="film" data-scene="street" data-seed="9" data-video><div class="rec"><span class="tc-dot"></span><span class="tc"></span></div><div class="lab">a7IV · S-Log3 · 35mm f1.2</div></div>
          <div class="cap"><div><span class="tag">evento</span><span class="tag">lanzamiento</span><div class="h3">Zentaurus: el lanzamiento</div></div><dl class="ficha-dl"><div><dt>Cliente</dt><dd>VAOMystique — Vanessa Osorio</dd></div><div><dt>Qué era</dt><dd>El lanzamiento de Zentaurus, un evento para sus clientes.</dd></div><div><dt>Qué hice</dt><dd>Estrategia de contenido · rodaje · edición</dd></div></dl></div></div>
        <div class="feature-aside"><span class="mono">cada caso, la misma ficha</span><p>Qué era, qué decidí y hasta dónde llegó. Pocos casos, completos y con su número.</p><a class="wbtn" href="/contacto#agenda">Charlemos →</a></div>
      </div>
    </div>
    <div class="mpanel" data-panel="edit">
      <p class="tab-intro">Edito para que se queden. Los primeros 3 segundos deciden si alguien sigue mirando, y cada corte tiene una razón.</p>
      <div class="mgrid">
        <div class="feature"><div class="film" data-scene="studio" data-seed="14" data-tone="bw" data-video><div class="demo"><div class="kin"><span>mirar</span><span>cortar</span><span>sentir</span><span>mirar</span></div></div><div class="lab">kinetic type</div></div>
          <div class="cap"><div><span class="tag">motion</span><div class="h3">Tipografía que se mueve al ritmo de la idea</div></div><dl class="ficha-dl"><div><dt>Qué hice</dt><dd>Edición · motion</dd></div></dl></div></div>
        <div class="side-list">
          <div class="side-item"><div class="film" data-scene="street" data-seed="31" data-video><div class="demo"><div class="wave"></div></div><div class="cutline"></div></div><div><span class="tag">ritmo</span><div class="h3">Corte al beat</div><div class="by">cada corte con una razón</div></div></div>
          <div class="side-item"><div class="film" data-scene="sky" data-seed="17" data-video></div><div><span class="tag">estilo</span><div class="h3">Match cut — mismo encuadre, día y noche</div><div class="by">transición</div></div></div>
          <div class="side-item"><div class="film" data-scene="flash" data-seed="8" data-video></div><div><span class="tag">color</span><div class="h3">Etalonaje S-Log3 → film</div><div class="by">color</div></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="metricas" id="metricas">
  <div class="ex-head"><div><div class="mono" style="color:#777">estratega creativo — resultados para marcas</div><h2 class="disp" data-r>Números <em>que se ven</em></h2></div><p class="maleta-p">Lo que hemos construido con las marcas. Solo números reales.</p></div>
  <div class="big-nums" data-r>{NUMBERS.map((n) => <div><b>{n.prefix}<span data-count={n.value}>{n.value}</span>{n.suffix}</b><span class="mono">{n.label}</span></div>)}</div>

  <div class="phones" data-r>
    {[['insights de Instagram — cuenta 01', 'alcance 30 días'], ['reel con más vistas', 'vistas · guardados'], ['crecimiento de seguidores', 'antes → después'], ['estadísticas de TikTok / YouTube', 'retención']].map(([l, c], i) => (
      <div class="phone"><Media label={l} kind="screenshot" scene={['bokeh', 'street', 'window', 'lamp'][i]} seed={i + 3} cap={c} /></div>
    ))}
  </div>

  <div class="ba" data-r>
    <div class="ba-h"><span class="mono">caso — antes y después</span><h3>Cuenta 01 <em>· 90 días</em></h3></div>
    <div class="ba-grid">
      <Media label="perfil antes (captura)" kind="screenshot" scene="studio" seed="2" tone="bw" cap="antes" />
      <div class="ba-arrow">→</div>
      <Media label="perfil después (captura)" kind="screenshot" scene="bokeh" seed="5" cap="después" />
      <p class="ba-change"><span class="mono">qué cambió</span>Definimos dos pilares, un plano de firma y un calendario de 12 piezas al mes.</p>
    </div>
  </div>

  <div class="wins" data-r>
    <div><span class="mono">logros</span>
      <ol>
        <li><b>4 países</b><i>Panamá, México, Brasil y Colombia.</i></li>
        <li><b>+8 eventos con marcas</b><i>nacionales e internacionales.</i></li>
        <li><b>Reconocimientos</b><i>Unión Europea en Colombia, Feria Internacional del Libro de Panamá y Sky Experience con Smartfit.</i></li>
      </ol>
    </div>
    <!-- Testimonios: se muestran cuando haya nombre, marca y foto reales (Vanessa, Christian). -->
  </div>
</section>

<section class="maleta" id="maleta">
  <div class="ex-head"><div><div class="mono" style="color:#777">fig. 005 — la maleta</div><h2 class="disp" data-r>Con qué <em>produzco</em></h2></div><p class="maleta-p">Lo que llevo a cada rodaje. Ábrela.</p></div>
  <Suitcase />
</section>

<section class="strip" id="rollo">
  <div class="strip-head"><h3>rollo 01 —<br><span class="it">lo cotidiano también es obra</span></h3><div class="mono" style="opacity:.6;align-self:end">36 exp · iso 800 · revelado a mano</div></div>
  <div class="reel" id="reel"></div>
</section>
<section class="next-cta"><span class="mono">¿te dieron ganas de crear algo parecido?</span><div class="cta-stack"><a class="wbtn" href="/contacto#agenda">Charlemos →</a><span class="mono cta-note">30 minutos para conocernos y destrabar ideas</span></div></section>
</main>
<script slot="scripts" is:inline>
  const sc = ['bokeh', 'park', 'window', 'street', 'lamp', 'sky', 'studio', 'flash', 'sofa', 'hands'];
  const one = i => '<div class="frame"><div class="film" data-scene="' + sc[i % sc.length] + '" data-seed="' + (50 + i) + '" ' + (i % 3 === 0 ? 'data-video' : '') + ' ' + (i % 4 === 1 ? 'data-tone="bw"' : '') + '></div><span class="no">▸ ' + String(i + 1).padStart(2, '0') + 'A &nbsp; KODAK 5219</span></div>';
  const set = Array.from({length: 10}, (_, i) => one(i)).join('');
  document.getElementById('reel').innerHTML = set + set;
  $$('.wave').forEach(w => { w.innerHTML = Array.from({length: 14}, (_, i) => '<i style="animation-delay:' + ((i * 0.07) % 1) + 's;animation-duration:' + (.5 + (i % 5) * .12) + 's"></i>').join(''); });
  $('#calMini').innerHTML = Array.from({length: 28}, (_, i) => '<i class="' + ([1,3,4,8,10,12,15,17,18,22,24,26].includes(i) ? 'f' : '') + '"></i>').join('');
  // /portfolio#film, #edit, #strat open that tab
  const openTab = () => { const h = location.hash.slice(1); if (['film', 'edit', 'strat'].includes(h)) { setTab('#portfolio', h); setTimeout(() => window.renderFilms && renderFilms(), 60); document.getElementById('portfolio').scrollIntoView(); } };
  addEventListener('load', openTab); addEventListener('hashchange', openTab);
</script>
</Base>
