---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { CONTACT } from '../lib/site.js';
import { PUBLIC_BOOKING_URL } from 'astro:env/client';
const mail = `mailto:${CONTACT.email}?subject=${encodeURIComponent('Quiero agendar una llamada')}`;
---
<Base title="Agenda 30 minutos — Be like José" description="Una llamada para encontrar en qué eje está el nudo de tu marca. Por Google Meet.">
<main class="page">
<section class="contact" id="contacto">
  <div class="film" data-scene="street" data-seed="44" data-video></div>
  <div class="mono" style="opacity:.7;margin-bottom:24px">agenda</div>
  <h2 class="disp just" data-r>¿y si lo hablamos?</h2>
  <p class="contact-promise" data-r>Treinta minutos, sin formularios eternos.</p>
  <div class="cgrid">
    <div><h6>escribe</h6><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></div>
    <div><h6>mira</h6><a href={CONTACT.instagram} target="_blank" rel="noopener">{CONTACT.instagramHandle}</a></div>
    <div><h6>agenda</h6><a class="hbtn" href="#agenda">Elegir horario ↓</a></div>
  </div>
</section>

<section class="agenda" id="agenda">
  <div class="agenda-head"><div class="mono" style="color:#777">agenda</div><h2 class="disp" data-r>Elige <em>día y hora</em></h2><p>Charlamos un rato, con café o un matecito, para destrabar ideas. Nos vemos por Google Meet.</p><p class="agenda-who"><span class="mono">ideal si</span>Tienes una marca personal, una empresa o eres creador y ya estás publicando.</p></div>
  <Booking url={PUBLIC_BOOKING_URL} length="Llamada de 30 minutos" />

  <div class="code-box" id="codeBox">
    <div class="code-l"><span class="mono">¿ya eres cliente?</span><h3>Sesión de trabajo <em>de 2 horas</em></h3><p>Escribe el código que te di y se abre mi agenda de sesiones para clientes.</p></div>
    <form class="code-f" id="codeForm" autocomplete="off">
      <input id="codeIn" name="code" placeholder="TU-CÓDIGO" aria-label="código de cliente" autocapitalize="characters" spellcheck="false" required />
      <button class="wbtn" type="submit" id="codeBtn" hidden>abrir agenda →</button>
      <span class="mono code-msg" id="codeMsg" role="status"></span>
    </form>
    <div class="code-ok" id="codeOk" hidden></div>
  </div>
</section>
<section class="after">
  <div class="mono" style="color:#777">qué pasa después</div>
  <ol class="after-steps" data-r>
    <li><span>01</span><b>Confirmas</b><i>Te llega el link para nuestra reunión.</i></li>
    <li><span>02</span><b>Hablamos</b><i>Revisamos lo que tienes, lo que te frena y lo que falta. Empecemos a trabajar o no, sales con claridad.</i></li>
    <li><span>03</span><b>Definimos</b><i>Si hay encaje, elegimos la modalidad, el alcance y el tiempo en la misma llamada. Si prefieres verlo por escrito, la propuesta te llega al día siguiente.</i></li>
  </ol>
  <a class="lnk mono" href="/mi-sistema#proceso">ver el proceso completo →</a>
</section>

<section class="lead-sec"><LeadMagnet /></section>
</main>
<script>
  const form = document.getElementById('codeForm') as HTMLFormElement;
  const msg = document.getElementById('codeMsg')!;
  const ok = document.getElementById('codeOk')!;
  const codeIn = document.getElementById('codeIn') as HTMLInputElement;
  const codeBtn = document.getElementById('codeBtn')!;
  codeIn.addEventListener('input', () => { codeBtn.hidden = codeIn.value.trim().length < 3; });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.textContent = 'revisando…';
    const code = (document.getElementById('codeIn') as HTMLInputElement).value;
    try {
      const r = await fetch('/api/cita', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code }) });
      const d = await r.json();
      if (!d.ok) { msg.textContent = d.reason === 'not-configured' ? 'la agenda de clientes aún no está activa.' : 'ese código no existe. revísalo o escríbeme.'; return; }
      msg.textContent = 'listo.';
      const url: string = d.url;
      const embed = url.includes('/appointments/schedules/') ? url + (url.includes('?') ? '&' : '?') + 'gv=true' : '';
      ok.innerHTML = embed
        ? `<iframe title="Agendar sesión de 2 horas" src="${embed}"></iframe>`
        : `<a class="wbtn" href="${url}" target="_blank" rel="noopener">elegir día y hora de la sesión →</a>`;
      ok.hidden = false; form.hidden = true;
    } catch { msg.textContent = 'no se pudo revisar el código. intenta de nuevo.'; }
  });
</script>
</Base>
